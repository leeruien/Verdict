@using VerdictApp.Models

@if (Replies.Any())
{
    <div class="replies-list">
        @foreach (var reply in Replies)
        {
            var childCount = CountDescendants(reply.Id);

            <div class="reply-card">
                <div class="comment-header">
                    @if (!string.IsNullOrWhiteSpace(reply.User?.ProfilePhotoPath))
                    {
                        <img src="@reply.User.ProfilePhotoPath" class="comment-avatar" style="object-fit:cover;" alt="" />
                    }
                    else
                    {
                        <div class="comment-avatar reply-avatar">@(reply.User?.DisplayName?[0].ToString().ToUpper() ?? "?")</div>
                    }
                    <div style="flex:1;">
                        <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                            <a class="comment-username username-link" href="/user/@reply.UserId">@(reply.User?.DisplayName ?? "Unknown")</a>
                            @if (GetVoteBadgeFunc != null)
                            {
                                var (label, css) = GetVoteBadgeFunc(reply.UserId);
                                @if (!string.IsNullOrEmpty(label))
                                {
                                    <span class="vote-badge @css">@label</span>
                                }
                            }
                        </div>
                        <span class="comment-date">
                            @reply.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")
                            @if (reply.EditedAt.HasValue)
                            {
                                <span class="edited-label">(edited @reply.EditedAt.Value.ToLocalTime().ToString("MMM d, yyyy · h:mm tt"))</span>
                            }
                        </span>
                    </div>
                </div>

                @if (editingReplyId == reply.Id)
                {
                    <div class="inline-reply-form">
                        <textarea @bind="editingReplyBody" @bind:event="oninput"
                                  class="comment-input"
                                  rows="2"></textarea>
                        <div class="inline-reply-actions">
                            <button class="comment-submit-btn"
                                    @onclick="() => SaveEditReply(reply.Id)"
                                    disabled="@string.IsNullOrWhiteSpace(editingReplyBody)">
                                Save
                            </button>
                            <button class="inline-cancel-btn" @onclick="CancelEditReply">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="comment-body">@reply.Body</p>
                }

                @if (confirmDeleteReplyId == reply.Id)
                {
                    <div class="confirm-bar danger">
                        <span>Delete this reply?</span>
                        <button class="confirm-yes danger" @onclick="() => ConfirmDeleteReply(reply.Id)">Delete</button>
                        <button class="confirm-no" @onclick="() => confirmDeleteReplyId = null">Cancel</button>
                    </div>
                }

                <div class="reply-action-row">
                    @if (CurrentUserId != null && !IsExpiredVal)
                    {
                        <button class="reply-btn" @onclick="() => ToggleInlineReply(reply.Id)">↩ Reply</button>
                    }
                    @if (reply.UserId == CurrentUserId)
                    {
                        <button class="comment-action-btn" @onclick="() => StartEditReply(reply.Id, reply.Body)">✏️ Edit</button>
                        <button class="comment-action-btn danger" @onclick="() => { confirmDeleteReplyId = reply.Id; editingReplyId = null; }">🗑️ Delete</button>
                    }
                    else if (CurrentUserId != null && OnReportComment != null)
                    {
                        @if (ReportedCommentIds.Contains(reply.Id))
                        {
                            <span class="report-done">✓ Reported</span>
                        }
                        else if (reportingReplyId == reply.Id)
                        {
                            <div class="comment-report-form">
                                <select class="report-select" @bind="replyReportReason">
                                    <option value="spam">Spam or misleading</option>
                                    <option value="inappropriate">Inappropriate content</option>
                                    <option value="harassment">Harassment or hate speech</option>
                                    <option value="other">Other</option>
                                </select>
                                <button class="report-submit-btn" @onclick="() => SubmitReplyReport(reply.Id)">Submit</button>
                                <button class="report-cancel-btn" @onclick="() => reportingReplyId = null">Cancel</button>
                            </div>
                        }
                        else
                        {
                            <button class="report-btn" @onclick='() => { reportingReplyId = reply.Id; replyReportReason = "spam"; }'>🚩 Report</button>
                        }
                    }
                    @if (childCount > 3 && !expandedThreads.Contains(reply.Id) && !ForceExpanded)
                    {
                        <button class="show-more-btn" @onclick="() => ExpandThread(reply.Id)">
                            ↓ Show @childCount repl@(childCount == 1 ? "y" : "ies")
                        </button>
                    }
                </div>
            </div>

            @if (activeInlineReplyId == reply.Id)
            {
                <div class="inline-reply-form">
                    <textarea @bind="inlineText" @bind:event="oninput"
                              placeholder="Write a reply…"
                              class="comment-input"
                              rows="2"></textarea>
                    <div class="inline-reply-actions">
                        <button class="comment-submit-btn"
                                @onclick="() => PostInlineReply(reply.Id)"
                                disabled="@(isPosting || string.IsNullOrWhiteSpace(inlineText))">
                            Post
                        </button>
                        <button class="inline-cancel-btn" @onclick="CancelInlineReply">Cancel</button>
                    </div>
                </div>
            }

            @if (ForceExpanded || childCount <= 3 || expandedThreads.Contains(reply.Id))
            {
                <ReplyThread AllComments="AllComments"
                             ParentId="reply.Id"
                             CurrentUserId="CurrentUserId"
                             IsExpiredVal="IsExpiredVal"
                             ForceExpanded="@(ForceExpanded || expandedThreads.Contains(reply.Id))"
                             OnPostReply="OnPostReply"
                             OnDeleteComment="OnDeleteComment"
                             OnEditComment="OnEditComment"
                             OnReportComment="OnReportComment"
                             ReportedCommentIds="ReportedCommentIds"
                             GetVoteBadgeFunc="GetVoteBadgeFunc" />
            }

            @if (childCount > 3 && expandedThreads.Contains(reply.Id) && !ForceExpanded)
            {
                <button class="show-more-btn" @onclick="() => { expandedThreads.Remove(reply.Id); StateHasChanged(); }">
                    ↑ Collapse replies
                </button>
            }
        }
    </div>
}

@code {
    [Parameter] public List<Comment> AllComments { get; set; } = new();
    [Parameter] public Guid ParentId { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public bool IsExpiredVal { get; set; }
    [Parameter] public bool ForceExpanded { get; set; }
    [Parameter] public Func<Guid, string, Task>? OnPostReply { get; set; }
    [Parameter] public Func<Guid, Task>? OnDeleteComment { get; set; }
    [Parameter] public Func<Guid, string, Task>? OnEditComment { get; set; }
    [Parameter] public Func<string?, (string, string)>? GetVoteBadgeFunc { get; set; }
    [Parameter] public Func<Guid, string, Task>? OnReportComment { get; set; }
    [Parameter] public HashSet<Guid> ReportedCommentIds { get; set; } = new();

    private Guid? activeInlineReplyId;
    private string inlineText = "";
    private bool isPosting;
    private HashSet<Guid> expandedThreads = new();

    private Guid? editingReplyId;
    private string editingReplyBody = "";
    private Guid? confirmDeleteReplyId;

    private Guid? reportingReplyId;
    private string replyReportReason = "spam";

    private void StartEditReply(Guid replyId, string body)
    {
        editingReplyId = replyId;
        editingReplyBody = body;
        confirmDeleteReplyId = null;
        activeInlineReplyId = null;
        StateHasChanged();
    }

    private void CancelEditReply()
    {
        editingReplyId = null;
        editingReplyBody = "";
        StateHasChanged();
    }

    private async Task SaveEditReply(Guid replyId)
    {
        if (OnEditComment == null || string.IsNullOrWhiteSpace(editingReplyBody)) return;
        await OnEditComment(replyId, editingReplyBody.Trim());
        editingReplyId = null;
        editingReplyBody = "";
    }

    private async Task ConfirmDeleteReply(Guid replyId)
    {
        if (OnDeleteComment == null) return;
        await OnDeleteComment(replyId);
        confirmDeleteReplyId = null;
    }

    private List<Comment> Replies => AllComments
        .Where(c => c.ParentCommentId == ParentId)
        .OrderBy(c => c.CreatedAt)
        .ToList();

    private int CountDescendants(Guid parentId)
    {
        var children = AllComments.Where(c => c.ParentCommentId == parentId).ToList();
        return children.Count + children.Sum(c => CountDescendants(c.Id));
    }

    private void ExpandThread(Guid replyId)
    {
        expandedThreads.Add(replyId);
        StateHasChanged();
    }

    private void ToggleInlineReply(Guid replyId)
    {
        activeInlineReplyId = activeInlineReplyId == replyId ? null : replyId;
        inlineText = "";
        StateHasChanged();
    }

    private void CancelInlineReply()
    {
        activeInlineReplyId = null;
        inlineText = "";
        StateHasChanged();
    }

    private async Task SubmitReplyReport(Guid replyId)
    {
        if (OnReportComment == null) return;
        await OnReportComment(replyId, replyReportReason);
        ReportedCommentIds.Add(replyId);
        reportingReplyId = null;
        StateHasChanged();
    }

    private async Task PostInlineReply(Guid parentId)
    {
        if (string.IsNullOrWhiteSpace(inlineText) || OnPostReply == null) return;
        isPosting = true;
        expandedThreads.Add(parentId);
        await OnPostReply(parentId, inlineText.Trim());
        inlineText = "";
        activeInlineReplyId = null;
        isPosting = false;
    }
}
