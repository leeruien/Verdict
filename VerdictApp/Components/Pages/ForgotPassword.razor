@page "/forgot-password"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject VerdictApp.Services.SupabaseAuthService SupabaseAuth
@inject NavigationManager Nav

<PageTitle>Forgot Password — Verdict</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">⚖</div>
        <h1 class="auth-title">Forgot password?</h1>

        @if (sent)
        {
            <div class="sent-box">
                <div class="sent-icon">📧</div>
                <p>If an account exists for <strong>@email</strong>, we've sent a password reset link. Check your inbox.</p>
                <a class="back-link" href="/login">← Back to login</a>
            </div>
        }
        else
        {
            <p class="auth-sub">Enter your email and we'll send you a reset link.</p>

            <div class="form-field">
                <label>Email</label>
                <input class="form-input" type="email" @bind="email" placeholder="you@example.com" />
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="auth-error">@error</p>
            }

            <button class="auth-btn" @onclick="Submit" disabled="@isBusy">
                @(isBusy ? "Sending…" : "Send reset link")
            </button>

            <p class="auth-switch"><a href="/login">← Back to login</a></p>
        }
    </div>
</div>

@code {
    private string email = "";
    private bool isBusy;
    private bool sent;
    private string? error;

    private async Task Submit()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            error = "Please enter a valid email address.";
            return;
        }

        isBusy = true;
        var redirectTo = $"{Nav.BaseUri}auth/reset-password";
        await SupabaseAuth.SendPasswordResetEmailAsync(email, redirectTo);
        sent = true;
        isBusy = false;
    }
}

<style>
    .auth-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        font-family: Georgia, serif;
    }

    .auth-card {
        width: 100%;
        max-width: 400px;
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 16px;
        padding: 2.5rem 2rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    }

    .auth-logo { font-size: 2rem; text-align: center; margin-bottom: 0.5rem; }

    .auth-title {
        text-align: center;
        font-size: 1.5rem;
        margin: 0 0 0.5rem;
        color: #052767;
    }

    .auth-sub {
        text-align: center;
        color: #888;
        font-size: 0.9rem;
        margin: 0 0 1.5rem;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        margin-bottom: 1rem;
    }

    .form-field label { font-size: 0.88rem; font-weight: 600; color: #333; }

    .form-input {
        padding: 0.6rem 0.85rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        font-family: Georgia, serif;
        width: 100%;
        box-sizing: border-box;
        transition: border-color 0.15s;
    }

    .form-input:focus { outline: none; border-color: #052767; }

    .auth-btn {
        width: 100%;
        padding: 0.75rem;
        background: #052767;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-family: Georgia, serif;
        cursor: pointer;
        transition: background 0.15s;
        margin-top: 0.25rem;
    }

    .auth-btn:hover:not(:disabled) { background: #3a0647; }
    .auth-btn:disabled { background: #aaa; cursor: not-allowed; }

    .auth-error {
        color: #c0392b;
        font-size: 0.85rem;
        margin: 0 0 0.5rem;
        padding: 0.5rem 0.75rem;
        background: #fdf2f2;
        border-radius: 6px;
        border-left: 3px solid #c0392b;
    }

    .auth-switch { text-align: center; font-size: 0.88rem; margin: 1rem 0 0; }
    .auth-switch a { color: #052767; text-decoration: none; }
    .auth-switch a:hover { text-decoration: underline; }

    .sent-box { text-align: center; padding: 0.5rem 0; }
    .sent-icon { font-size: 2.5rem; margin-bottom: 0.75rem; }
    .sent-box p { color: #444; font-size: 0.95rem; line-height: 1.55; margin: 0 0 1.25rem; }

    .back-link { color: #052767; text-decoration: none; font-size: 0.9rem; font-weight: 600; }
    .back-link:hover { text-decoration: underline; }
</style>
