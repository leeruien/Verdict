@page "/inbox/{ConversationId:guid}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VerdictApp.Data
@using VerdictApp.Models
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@attribute [Authorize]

<PageTitle>Chat</PageTitle>

@if (conversation == null)
{
    <p class="loading">Loading…</p>
}
else
{
    var other = conversation.InitiatorId == currentUserId ? conversation.Recipient : conversation.Initiator;

    <div class="chat-page">
        <div class="chat-header">
            <a class="back-btn" href="/inbox">← Inbox</a>
            <div class="chat-with">
                <div class="avatar">@(other.DisplayName?[0].ToString().ToUpper() ?? "?")</div>
                <span>@other.DisplayName</span>
            </div>
        </div>

        @if (conversation.Status == ConversationStatus.Pending && conversation.RecipientId == currentUserId)
        {
            <div class="request-banner">
                <p><strong>@conversation.Initiator.DisplayName</strong> sent you a message request.</p>
                <div class="request-actions">
                    <button class="accept-btn" @onclick="Accept">Accept</button>
                    <button class="decline-btn" @onclick="Decline">Decline</button>
                </div>
            </div>

            @* Show the initial message read-only *@
            @foreach (var msg in conversation.Messages.OrderBy(m => m.SentAt))
            {
                <div class="msg-row other">
                    <div class="bubble other-bubble">@msg.Body</div>
                    <span class="msg-time">@FormatTime(msg.SentAt)</span>
                </div>
            }
        }
        else if (conversation.Status == ConversationStatus.Pending && conversation.InitiatorId == currentUserId)
        {
            <div class="waiting-banner">
                <p>⏳ Waiting for <strong>@conversation.Recipient.DisplayName</strong> to accept your request.</p>
            </div>
            @foreach (var msg in conversation.Messages.OrderBy(m => m.SentAt))
            {
                <div class="msg-row me">
                    <div class="bubble me-bubble">@msg.Body</div>
                    <span class="msg-time">@FormatTime(msg.SentAt)</span>
                </div>
            }
        }
        else if (conversation.Status == ConversationStatus.Declined)
        {
            <div class="declined-banner">
                <p>This message request was declined.</p>
            </div>
        }
        else
        {
            <div class="messages-list">
                @foreach (var msg in conversation.Messages.OrderBy(m => m.SentAt))
                {
                    var isMe = msg.SenderId == currentUserId;
                    <div class="msg-row @(isMe ? "me" : "other")">
                        <div class="bubble @(isMe ? "me-bubble" : "other-bubble")">@msg.Body</div>
                        <span class="msg-time">@FormatTime(msg.SentAt)</span>
                    </div>
                }
            </div>

            <div class="chat-input-row">
                <textarea class="chat-input" rows="2"
                          placeholder="Type a message…"
                          @bind="newMessage"
                          @bind:event="oninput"
                          @onkeydown="HandleKey"></textarea>
                <button class="chat-send-btn" @onclick="SendMessage"
                        disabled="@(isBusy || string.IsNullOrWhiteSpace(newMessage))">
                    Send
                </button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid ConversationId { get; set; }

    private Conversation? conversation;
    private string? currentUserId;
    private string newMessage = "";
    private bool isBusy = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        currentUserId = user?.Id;
        if (currentUserId == null) { Nav.NavigateTo("/login"); return; }

        await LoadConversation();

        if (conversation == null ||
            (conversation.InitiatorId != currentUserId && conversation.RecipientId != currentUserId))
        {
            Nav.NavigateTo("/inbox");
        }
    }

    private async Task LoadConversation()
    {
        conversation = await Db.Conversations
            .Include(c => c.Initiator)
            .Include(c => c.Recipient)
            .Include(c => c.Messages.OrderBy(m => m.SentAt))
            .FirstOrDefaultAsync(c => c.Id == ConversationId);
    }

    private async Task Accept()
    {
        if (conversation == null) return;
        conversation.Status = ConversationStatus.Accepted;
        await Db.SaveChangesAsync();
        StateHasChanged();
    }

    private async Task Decline()
    {
        if (conversation == null) return;
        conversation.Status = ConversationStatus.Declined;
        await Db.SaveChangesAsync();
        Nav.NavigateTo("/inbox");
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage) || conversation == null) return;
        isBusy = true;

        Db.DirectMessages.Add(new DirectMessage
        {
            Id = Guid.NewGuid(),
            ConversationId = conversation.Id,
            SenderId = currentUserId!,
            Body = newMessage.Trim(),
            SentAt = DateTime.UtcNow
        });
        await Db.SaveChangesAsync();

        newMessage = "";
        await LoadConversation();
        isBusy = false;
        StateHasChanged();
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private string FormatTime(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 1)  return "just now";
        if (diff.TotalHours < 1)    return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1)     return dt.ToString("h:mm tt");
        return dt.ToString("MMM d · h:mm tt");
    }
}

<style>
    .chat-page {
        max-width: 640px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: Georgia, serif;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 7rem);
    }

    .chat-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .back-btn {
        color: #052767;
        font-size: 0.9rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .back-btn:hover { text-decoration: underline; }

    .chat-with {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        font-weight: 600;
        font-size: 1.1rem;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #052767, #3a0647);
        color: white;
        font-size: 0.85rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* Banners */
    .request-banner {
        background: #f0f4ff;
        border: 1px solid #d8e4ff;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
    }

    .request-banner p { margin: 0 0 0.75rem; font-size: 0.95rem; }

    .request-actions { display: flex; gap: 0.75rem; }

    .accept-btn {
        padding: 0.45rem 1.25rem;
        background: #052767;
        color: white;
        border: none;
        border-radius: 20px;
        font-size: 0.88rem;
        cursor: pointer;
        transition: background 0.15s;
    }

    .accept-btn:hover { background: #3a0647; }

    .decline-btn {
        padding: 0.45rem 1.25rem;
        background: none;
        color: #888;
        border: 1px solid #ccc;
        border-radius: 20px;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .decline-btn:hover { border-color: #e06c75; color: #e06c75; }

    .waiting-banner, .declined-banner {
        background: #f9f9f9;
        border: 1px solid #e8e8e8;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
        color: #888;
        font-size: 0.92rem;
    }

    .waiting-banner p, .declined-banner p { margin: 0; }

    /* Messages */
    .messages-list {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-bottom: 0.5rem;
    }

    .msg-row {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .msg-row.me    { align-items: flex-end; }
    .msg-row.other { align-items: flex-start; }

    .bubble {
        max-width: 72%;
        padding: 0.6rem 0.9rem;
        border-radius: 16px;
        font-size: 0.92rem;
        line-height: 1.45;
        word-break: break-word;
    }

    .me-bubble    { background: #052767; color: white; border-bottom-right-radius: 4px; }
    .other-bubble { background: #f0f0f0; color: #222;  border-bottom-left-radius: 4px; }

    .msg-time { font-size: 0.7rem; color: #bbb; padding: 0 0.25rem; }

    /* Input */
    .chat-input-row {
        display: flex;
        gap: 0.5rem;
        align-items: flex-end;
        padding-top: 0.75rem;
        border-top: 1px solid #f0f0f0;
        margin-top: auto;
    }

    .chat-input {
        flex: 1;
        padding: 0.6rem 0.85rem;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 0.92rem;
        font-family: Georgia, serif;
        resize: none;
        line-height: 1.4;
    }

    .chat-input:focus { outline: none; border-color: #052767; }

    .chat-send-btn {
        padding: 0.6rem 1.2rem;
        background: #052767;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 0.9rem;
        cursor: pointer;
        transition: background 0.15s;
        white-space: nowrap;
    }

    .chat-send-btn:hover:not(:disabled) { background: #3a0647; }
    .chat-send-btn:disabled { background: #aaa; cursor: not-allowed; }

    .loading { text-align: center; color: #aaa; padding: 3rem 0; font-style: italic; }
</style>
