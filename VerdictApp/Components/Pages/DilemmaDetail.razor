@page "/dilemma/{Id:guid}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Runtime.CompilerServices
@using VerdictApp.Data
@using VerdictApp.Models
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject VerdictApp.Services.NotificationService NotificationSvc
@inject IJSRuntime JS
@inject VerdictApp.Services.RecentGroupsNotifier RecentNotifier

@if (dilemma == null)
{
    <p class="loading">Loading...</p>
}
else if (postAlreadyReported)
{
    <div class="detail-page">
        <a class="back-btn" href="javascript:history.back()">← Back</a>
        <div class="reported-post-notice">
            <span class="reported-icon">🚩</span>
            <p>You've reported this post. It's hidden from your view.</p>
            <a href="/">Go home</a>
        </div>
    </div>
}
else
{
    <div class="detail-page">
        <a class="back-btn" href="javascript:history.back()">← Back</a>
        <div class="detail-header">
            <div class="detail-meta">
                @if (!string.IsNullOrEmpty(dilemma.Category))
                {
                    <a class="category-tag" href="/group/@dilemma.Category">@GetCategoryIcon(dilemma.Category) @dilemma.Category</a>
                }
                <span class="time-left">⏱ @GetTimeLeft(dilemma.ExpiresAt)</span>
                <a class="user username-link" href="/user/@dilemma.UserId">@(dilemma.User?.DisplayName ?? dilemma.User?.UserName ?? "Unknown")</a>
            </div>
            <h1 class="detail-title">@dilemma.Title</h1>
            @if (!string.IsNullOrWhiteSpace(dilemma.Description))
            {
                <p class="detail-desc">@dilemma.Description</p>
            }
            @if (dilemma.ImagePathList.Any())
            {
                @if (dilemma.ImagePathList.Count == 1)
                {
                    <div class="image-gallery">
                        <img src="@dilemma.ImagePathList[0]" alt="Post image" class="gallery-img" />
                    </div>
                }
                else
                {
                    <div class="image-carousel">
                        <img src="@dilemma.ImagePathList[activeImageIndex]"
                             alt="Image @(activeImageIndex + 1) of @dilemma.ImagePathList.Count"
                             class="gallery-img" />
                        <button class="carousel-arrow carousel-prev"
                                @onclick="PrevImage"
                                disabled="@(activeImageIndex == 0)">&#8249;</button>
                        <button class="carousel-arrow carousel-next"
                                @onclick="NextImage"
                                disabled="@(activeImageIndex == dilemma.ImagePathList.Count - 1)">&#8250;</button>
                        <div class="carousel-dots">
                            @for (int i = 0; i < dilemma.ImagePathList.Count; i++)
                            {
                                var idx = i;
                                <button class="carousel-dot @(activeImageIndex == idx ? "active" : "")"
                                        @onclick="() => activeImageIndex = idx"></button>
                            }
                        </div>
                    </div>
                }
            }

            @if (currentUserId != null && dilemma.UserId != currentUserId)
            {
                <div class="kebab-wrapper">
                    <button class="kebab-btn" @onclick="() => showReportMenu = !showReportMenu">⋮</button>
                    @if (showReportMenu)
                    {
                        <div class="kebab-menu">
                            @if (postAlreadyReported)
                            {
                                <span class="kebab-item reported-item">✓ Reported</span>
                            }
                            else
                            {
                                <button class="kebab-item" @onclick='() => { showReportMenu = false; showReportPost = true; reportReason = "spam"; }'>🚩 Report post</button>
                            }
                        </div>
                    }
                </div>
                @if (showReportPost && !postAlreadyReported)
                {
                    <div class="report-form">
                        <span class="report-label">Why are you reporting this post?</span>
                        <select class="report-select" @bind="reportReason">
                            <option value="spam">Spam or misleading</option>
                            <option value="inappropriate">Inappropriate content</option>
                            <option value="harassment">Harassment or hate speech</option>
                            <option value="other">Other</option>
                        </select>
                        <div class="report-actions">
                            <button class="report-submit-btn" @onclick="SubmitPostReport">Submit</button>
                            <button class="report-cancel-btn" @onclick="() => showReportPost = false">Cancel</button>
                        </div>
                    </div>
                }
            }

            @if (dilemma.UserId == currentUserId)
            {
                <div class="kebab-wrapper">
                    <button class="kebab-btn" @onclick="() => showOwnerMenu = !showOwnerMenu">⋮</button>
                    @if (showOwnerMenu)
                    {
                        <div class="kebab-menu">
                            <button class="kebab-item" @onclick="() => { StartEdit(); showOwnerMenu = false; }">✏️ Edit description</button>
                            <button class="kebab-item danger" @onclick="() => { showDeleteConfirm = true; showOwnerMenu = false; }">🗑️ Delete post</button>
                        </div>
                    }
                </div>

                @if (isEditingDescription)
                {
                    <div class="edit-desc-form">
                        <textarea class="edit-desc-input" @bind="editedDescription" rows="4"></textarea>
                        @if (showSaveEditConfirm)
                        {
                            <div class="confirm-bar neutral">
                                <span>Save changes to your description?</span>
                                <button class="confirm-yes" @onclick="SaveDescription">Save</button>
                                <button class="confirm-no" @onclick="() => showSaveEditConfirm = false">Back</button>
                            </div>
                        }
                        else
                        {
                            <div class="owner-actions">
                                <button class="owner-btn" @onclick="() => showSaveEditConfirm = true">Save</button>
                                <button class="owner-btn ghost" @onclick="CancelEdit">Cancel</button>
                            </div>
                        }
                    </div>
                }
                else if (showDeleteConfirm)
                {
                    <div class="confirm-bar danger">
                        <span>Permanently delete this post?</span>
                        <button class="confirm-yes danger" @onclick="DeletePost" disabled="@isBusy">Delete</button>
                        <button class="confirm-no" @onclick="() => showDeleteConfirm = false">Cancel</button>
                    </div>
                }
            }
        </div>

        <div class="section">
            <h2 class="section-title">Cast your vote</h2>
            <div class="options-list">
                @foreach (var option in dilemma.Options)
                {
                    var totalVotes = dilemma.Options.Sum(o => o.Votes.Count);
                    var optionVotes = option.Votes.Count;
                    var percent = totalVotes > 0
                        ? (int)Math.Round((double)optionVotes / totalVotes * 100)
                        : 0;
                    var userVotedThis = userVotedOptionIds.Contains(option.Id);
                    var hasVoted = HasVoted();
                    var isOwner = dilemma.UserId == currentUserId;
                    var expired = IsExpired();

                    <button class="option-btn @(userVotedThis ? "voted" : "") @(hasVoted && !isChangingVote && !userVotedThis ? "dimmed" : "")"
                            @onclick="() => CastVote(option)"
                            disabled="@((hasVoted && !isChangingVote) || isOwner || expired)">
                        <div class="option-content">
                            <span class="option-text">@option.OptionText</span>
                            @if (hasVoted || expired || isOwner)
                            {
                                <span class="option-percent">@percent%</span>
                            }
                        </div>
                        @if (hasVoted || expired || isOwner)
                        {
                            <div class="progress-bar">
                                <div class="progress-fill @(userVotedThis ? "fill-voted" : "")"
                                     style="width: @(percent)%"></div>
                            </div>
                        }
                    </button>
                }
            </div>

            @if (dilemma.UserId == currentUserId)
            {
                <p class="info-msg">You cannot vote on your own dilemma.</p>
            }
            else if (IsExpired())
            {
                <p class="info-msg">This dilemma has expired.</p>
            }
            else if (HasVoted() && !isChangingVote)
            {
                @if (showRemoveVoteConfirm)
                {
                    <div class="confirm-bar neutral">
                        <span>Remove your vote?</span>
                        <button class="confirm-yes" @onclick="RemoveVote">Remove</button>
                        <button class="confirm-no" @onclick="() => showRemoveVoteConfirm = false">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="voter-actions">
                        <button class="owner-btn" @onclick="StartChangeVote">🔄 Change vote</button>
                        <button class="owner-btn ghost danger" @onclick="() => showRemoveVoteConfirm = true">✕ Remove vote</button>
                    </div>
                }
            }
            else if (isChangingVote)
            {
                <p class="info-msg">Select a new option above to change your vote.</p>
            }
        </div>

        <!-- Comments -->
        <div class="section">
            <h2 class="section-title">Comments (@dilemma.Comments.Count(c => c.Id != null))</h2>

            @if (currentUserId != null && !IsExpired())
            {
                <div class="comment-form">
                    @if (replyingToCommentId != null)
                    {
                        <div class="replying-to-banner">
                            ↩ Replying to <strong>@replyingToUsername</strong>
                            <button class="cancel-reply-btn" @onclick="CancelReply">✕ Cancel</button>
                        </div>
                    }
                    <textarea @bind="newComment"
                              @bind:event="oninput"
                              placeholder="@(replyingToCommentId != null ? $"Reply to {replyingToUsername}..." : "Share your thoughts...")"
                              class="comment-input"
                              rows="3"></textarea>
                    <button class="comment-submit-btn"
                            @onclick="PostComment"
                            disabled="@(isBusy || string.IsNullOrWhiteSpace(newComment))">
                        @(replyingToCommentId != null ? "Post Reply" : "Post Comment")
                    </button>
                </div>
            }

            @if (!dilemma.Comments.Any(c => c.ParentCommentId == null))
            {
                <p class="empty-state">No comments yet. Be the first!</p>
            }
            else
            {
                @foreach (var comment in dilemma.Comments
                    .Where(c => c.ParentCommentId == null)
                    .OrderBy(c => c.CreatedAt))
                {
                    if (reportedCommentIds.Contains(comment.Id)) continue;
                    <div class="comment-card">
                        <div class="comment-header">
                            @if (!string.IsNullOrWhiteSpace(comment.User?.ProfilePhotoPath))
                            {
                                <img src="@comment.User.ProfilePhotoPath" class="comment-avatar" style="object-fit:cover;" alt="" />
                            }
                            else
                            {
                                <div class="comment-avatar">@(comment.User?.DisplayName?[0].ToString().ToUpper() ?? "?")</div>
                            }
                            <div style="flex:1;">
                                <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                    <a class="comment-username username-link" href="/user/@comment.UserId">@(comment.User?.DisplayName ?? "Unknown")</a>
                                    @{ var (label, css) = GetVoteBadge(comment.UserId); }
                                    @if (!string.IsNullOrEmpty(label))
                                    {
                                        <span class="vote-badge @css">@label</span>
                                    }
                                </div>
                                <span class="comment-date">
                                    @comment.CreatedAt.ToLocalTime().ToString("MMM d, yyyy · h:mm tt")
                                    @if (comment.EditedAt.HasValue)
                                    {
                                        <span class="edited-label">(edited @comment.EditedAt.Value.ToLocalTime().ToString("MMM d, yyyy · h:mm tt"))</span>
                                    }
                                </span>
                            </div>
                        </div>
                        @if (editingCommentId == comment.Id)
                        {
                            <div class="inline-reply-form">
                                <textarea @bind="editingCommentBody" @bind:event="oninput"
                                          class="comment-input"
                                          rows="2"></textarea>
                                <div class="inline-reply-actions">
                                    <button class="comment-submit-btn"
                                            @onclick="() => SaveCommentEdit(comment.Id, editingCommentBody)"
                                            disabled="@(isBusy || string.IsNullOrWhiteSpace(editingCommentBody))">
                                        Save
                                    </button>
                                    <button class="inline-cancel-btn" @onclick="CancelEditComment">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="comment-body">@comment.Body</p>
                        }

                        @if (confirmDeleteCommentId == comment.Id)
                        {
                            <div class="confirm-bar danger">
                                <span>Delete this comment?</span>
                                <button class="confirm-yes danger" @onclick="() => DeleteCommentWithReplies(comment.Id)" disabled="@isBusy">Delete</button>
                                <button class="confirm-no" @onclick="() => confirmDeleteCommentId = null">Cancel</button>
                            </div>
                        }

                        <div class="reply-action-row">
                            @if (currentUserId != null && !IsExpired())
                            {
                                <button class="reply-btn" @onclick="() => ToggleCommentReply(comment.Id)">
                                    ↩ Reply
                                </button>
                            }
                            @if (comment.UserId == currentUserId)
                            {
                                <button class="comment-action-btn" @onclick="() => StartEditComment(comment.Id, comment.Body)">✏️ Edit</button>
                                <button class="comment-action-btn danger" @onclick="() => { confirmDeleteCommentId = comment.Id; editingCommentId = null; }">🗑️ Delete</button>
                            }
                            else if (currentUserId != null)
                            {
                                @if (reportedCommentIds.Contains(comment.Id))
                                {
                                    <span class="report-done">✓ Reported</span>
                                }
                                else if (reportingCommentId == comment.Id)
                                {
                                    <div class="comment-report-form">
                                        <select class="report-select" @bind="reportReason">
                                            <option value="spam">Spam or misleading</option>
                                            <option value="inappropriate">Inappropriate content</option>
                                            <option value="harassment">Harassment or hate speech</option>
                                            <option value="other">Other</option>
                                        </select>
                                        <button class="report-submit-btn" @onclick="() => SubmitCommentReport(comment.Id)">Submit</button>
                                        <button class="report-cancel-btn" @onclick="() => reportingCommentId = null">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <button class="report-btn" @onclick='() => { reportingCommentId = comment.Id; reportReason = "spam"; }'>🚩 Report</button>
                                }
                            }
                        </div>

                        @if (activeCommentReplyId == comment.Id)
                        {
                            <div class="inline-reply-form">
                                <textarea @bind="commentInlineText" @bind:event="oninput"
                                          placeholder="Write a reply…"
                                          class="comment-input"
                                          rows="2"></textarea>
                                <div class="inline-reply-actions">
                                    <button class="comment-submit-btn"
                                            @onclick="() => PostCommentReplyInline(comment.Id)"
                                            disabled="@(isBusy || string.IsNullOrWhiteSpace(commentInlineText))">
                                        Post
                                    </button>
                                    <button class="inline-cancel-btn" @onclick="CancelCommentReply">Cancel</button>
                                </div>
                            </div>
                        }

                        <ReplyThread AllComments="@dilemma.Comments.ToList()"
                                     ParentId="@comment.Id"
                                     CurrentUserId="@currentUserId"
                                     IsExpiredVal="@IsExpired()"
                                     OnPostReply="@PostReplyInline"
                                     OnDeleteComment="@DeleteCommentWithReplies"
                                     OnEditComment="@SaveCommentEdit"
                                     OnReportComment="@ReportCommentFromThread"
                                     ReportedCommentIds="@reportedCommentIds"
                                     GetVoteBadgeFunc="@GetVoteBadge" />
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Dilemma? dilemma;
    private string? currentUserId;
    private HashSet<Guid> userVotedOptionIds = new();
    private Dictionary<string, string> commenterVotes = new();
    private string newComment = "";
    private bool isBusy = false;

    // Reply state
    private Guid? replyingToCommentId = null;
    private Guid? activeCommentReplyId;
    private string commentInlineText = "";
    private string replyingToUsername = "";

    // Owner edit/delete state
    private bool isEditingDescription = false;
    private string editedDescription = "";
    private bool showSaveEditConfirm = false;
    private bool showDeleteConfirm = false;
    private bool showOwnerMenu = false;

    // Voter change/remove state
    private bool isChangingVote = false;
    private bool showRemoveVoteConfirm = false;

    // Comment edit/delete state
    private Guid? editingCommentId;
    private string editingCommentBody = "";
    private Guid? confirmDeleteCommentId;

    // Image carousel state
    private int activeImageIndex = 0;
    private void PrevImage() { if (activeImageIndex > 0) activeImageIndex--; }
    private void NextImage() { if (dilemma != null && activeImageIndex < dilemma.ImagePathList.Count - 1) activeImageIndex++; }

    // Report state
    private bool showReportMenu = false;
    private bool showReportPost = false;
    private Guid? reportingCommentId;
    private string reportReason = "spam";
    private bool postAlreadyReported = false;
    private HashSet<Guid> reportedCommentIds = new();

    private record CategoryOption(string Value, string Label, string Icon);
    private List<CategoryOption> categories = new()
    {
        new("life",          "Life",          "🌱"),
        new("career",        "Career",        "💼"),
        new("finance",       "Finance",       "💰"),
        new("relationships", "Relationships", "❤️"),
        new("travel",        "Travel",        "✈️"),
        new("health",        "Health",        "🏃"),
        new("tech",          "Tech",          "💻"),
        new("other",         "Other",         "🤔"),
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        currentUserId = user?.Id;

        var customCommunities = await Db.Communities.ToListAsync();
        foreach (var c in customCommunities)
            if (categories.All(x => x.Value != c.Slug))
                categories.Add(new(c.Slug, c.Name, c.Icon));

        await LoadDilemma();

        if (currentUserId != null)
        {
            var myVotes = await Db.Votes
                .Where(v => v.UserId == currentUserId)
                .Select(v => v.DilemmaOptionId)
                .ToListAsync();
            userVotedOptionIds = myVotes.ToHashSet();

            postAlreadyReported = await Db.Reports.AnyAsync(r =>
                r.ReporterUserId == currentUserId && r.DilemmaId == Id);

            var myCommentReports = await Db.Reports
                .Where(r => r.ReporterUserId == currentUserId && r.CommentId != null)
                .Select(r => r.CommentId!.Value)
                .ToListAsync();
            reportedCommentIds = myCommentReports.ToHashSet();
        }
    }

    private async Task LoadDilemma()
    {
        if (currentUserId == null) { Nav.NavigateTo("/login"); return; }
        dilemma = await Db.Dilemmas
            .Include(d => d.Options).ThenInclude(o => o.Votes)
            .Include(d => d.Comments).ThenInclude(c => c.User)
            .Include(d => d.Comments).ThenInclude(c => c.Replies).ThenInclude(r => r.User)
            .FirstOrDefaultAsync(d => d.Id == Id);

        if (dilemma == null)
        {
            Nav.NavigateTo("/");
            return;
        }

        commenterVotes = dilemma.Options
            .SelectMany(o => o.Votes.Select(v => (v.UserId, o.OptionText)))
            .GroupBy(x => x.UserId)
            .ToDictionary(g => g.Key, g => g.First().OptionText);
    }

    private async Task SubmitPostReport()
    {
        if (currentUserId == null || postAlreadyReported) return;
        var already = await Db.Reports.AnyAsync(r =>
            r.ReporterUserId == currentUserId && r.DilemmaId == Id);
        if (!already)
        {
            Db.Reports.Add(new VerdictApp.Models.Report
            {
                Id = Guid.NewGuid(),
                ReporterUserId = currentUserId,
                DilemmaId = Id,
                Reason = reportReason,
                CreatedAt = DateTime.UtcNow
            });
            await Db.SaveChangesAsync();
        }
        postAlreadyReported = true;
        showReportPost = false;
    }

    private async Task SubmitCommentReport(Guid commentId)
    {
        if (currentUserId == null) return;
        var already = await Db.Reports.AnyAsync(r =>
            r.ReporterUserId == currentUserId && r.CommentId == commentId);
        if (!already)
        {
            Db.Reports.Add(new VerdictApp.Models.Report
            {
                Id = Guid.NewGuid(),
                ReporterUserId = currentUserId,
                CommentId = commentId,
                Reason = reportReason,
                CreatedAt = DateTime.UtcNow
            });
            await Db.SaveChangesAsync();
        }
        reportedCommentIds.Add(commentId);
        reportingCommentId = null;
    }

    private async Task ReportCommentFromThread(Guid commentId, string reason)
    {
        reportReason = reason;
        await SubmitCommentReport(commentId);
    }

    private async Task CastVote(DilemmaOption option)
    {
        if (currentUserId == null) { Nav.NavigateTo("/login"); return; }
        if (IsExpired()) return;

        if (isChangingVote)
        {
            // Find the voted option that belongs to THIS dilemma (not any other)
            var oldOptionId = dilemma!.Options
                .Select(o => o.Id)
                .FirstOrDefault(id => userVotedOptionIds.Contains(id));
            if (oldOptionId != Guid.Empty)
            {
                var oldVote = await Db.Votes.FirstOrDefaultAsync(v => v.UserId == currentUserId && v.DilemmaOptionId == oldOptionId);
                if (oldVote != null) Db.Votes.Remove(oldVote);
                userVotedOptionIds.Remove(oldOptionId);
            }
            isChangingVote = false;
        }
        else if (HasVoted()) return;

        var vote = new Vote
        {
            Id = Guid.NewGuid(),
            UserId = currentUserId,
            DilemmaOptionId = option.Id,
            CreatedAt = DateTime.UtcNow
        };

        Db.Votes.Add(vote);
        await Db.SaveChangesAsync();

        var voter = await UserManager.FindByIdAsync(currentUserId);
        if (voter != null && dilemma!.UserId != currentUserId)
            await NotificationSvc.NotifyVoteAsync(voter.DisplayName ?? voter.Email ?? "Someone", dilemma);

        userVotedOptionIds.Add(option.Id);
        await LoadDilemma();
        StateHasChanged();
    }

    // ── Owner: edit description ──────────────────────────────────────────
    private void StartEdit()
    {
        editedDescription = dilemma?.Description ?? "";
        isEditingDescription = true;
        showSaveEditConfirm = false;
        showDeleteConfirm = false;
    }

    private void CancelEdit()
    {
        isEditingDescription = false;
        showSaveEditConfirm = false;
    }

    private async Task SaveDescription()
    {
        if (dilemma == null) return;
        var entry = await Db.Dilemmas.FindAsync(dilemma.Id);
        if (entry != null)
        {
            entry.Description = editedDescription.Trim();
            await Db.SaveChangesAsync();
            dilemma.Description = entry.Description;
        }
        isEditingDescription = false;
        showSaveEditConfirm = false;
        StateHasChanged();
    }

    // ── Owner: delete post ───────────────────────────────────────────────
    private async Task DeletePost()
    {
        if (dilemma == null) return;
        isBusy = true;

        var notifs = await Db.Notifications.Where(n => n.DilemmaId == dilemma.Id).ToListAsync();
        Db.Notifications.RemoveRange(notifs);

        foreach (var opt in dilemma.Options)
        {
            var votes = await Db.Votes.Where(v => v.DilemmaOptionId == opt.Id).ToListAsync();
            Db.Votes.RemoveRange(votes);
        }
        Db.DilemmaOptions.RemoveRange(dilemma.Options);

        var comments = await Db.Comments.Where(c => c.DilemmaId == dilemma.Id).ToListAsync();
        Db.Comments.RemoveRange(comments);

        Db.Dilemmas.Remove(dilemma);
        await Db.SaveChangesAsync();

        Nav.NavigateTo("/");
    }

    // ── Voter: change / remove vote ──────────────────────────────────────
    private void StartChangeVote()
    {
        isChangingVote = true;
        showRemoveVoteConfirm = false;
    }

    private async Task RemoveVote()
    {
        if (currentUserId == null || dilemma == null) return;
        // Scope the lookup to options that belong to THIS dilemma only
        var oldOptionId = dilemma.Options
            .Select(o => o.Id)
            .FirstOrDefault(id => userVotedOptionIds.Contains(id));
        if (oldOptionId != Guid.Empty)
        {
            var vote = await Db.Votes.FirstOrDefaultAsync(v => v.UserId == currentUserId && v.DilemmaOptionId == oldOptionId);
            if (vote != null) Db.Votes.Remove(vote);
            await Db.SaveChangesAsync();
            userVotedOptionIds.Remove(oldOptionId);
        }
        showRemoveVoteConfirm = false;
        await LoadDilemma();
        StateHasChanged();
    }

    private async Task PostComment()
    {
        if (currentUserId == null || string.IsNullOrWhiteSpace(newComment)) return;
        isBusy = true;

        var comment = new Comment
        {
            Id = Guid.NewGuid(),
            UserId = currentUserId,
            DilemmaId = Id,
            Body = newComment.Trim(),
            CreatedAt = DateTime.UtcNow,
            ParentCommentId = replyingToCommentId
        };

        Db.Comments.Add(comment);
        await Db.SaveChangesAsync();

        var commenter = await UserManager.FindByIdAsync(currentUserId);
        if (commenter != null && dilemma != null)
            await NotificationSvc.NotifyCommentAsync(commenter.DisplayName ?? commenter.Email ?? "Someone", dilemma, currentUserId);

        await LoadDilemma();
        newComment = "";
        replyingToCommentId = null;
        replyingToUsername = "";
        isBusy = false;
        StateHasChanged();
    }

    private void StartReply(Guid commentId, string username)
    {
        replyingToCommentId = commentId;
        replyingToUsername = username;
        newComment = "";
    }

    private void ToggleCommentReply(Guid commentId)
    {
        activeCommentReplyId = activeCommentReplyId == commentId ? null : commentId;
        commentInlineText = "";
    }

    private void CancelCommentReply()
    {
        activeCommentReplyId = null;
        commentInlineText = "";
    }

    private async Task PostCommentReplyInline(Guid parentId)
    {
        if (string.IsNullOrWhiteSpace(commentInlineText)) return;
        await PostReplyInline(parentId, commentInlineText.Trim());
        activeCommentReplyId = null;
        commentInlineText = "";
    }

    private async Task PostReplyInline(Guid parentId, string body)
    {
        if (currentUserId == null || string.IsNullOrWhiteSpace(body)) return;
        isBusy = true;

        var comment = new Comment
        {
            Id = Guid.NewGuid(),
            UserId = currentUserId,
            DilemmaId = Id,
            Body = body,
            CreatedAt = DateTime.UtcNow,
            ParentCommentId = parentId
        };

        Db.Comments.Add(comment);
        await Db.SaveChangesAsync();

        var commenter = await UserManager.FindByIdAsync(currentUserId);
        if (commenter != null && dilemma != null)
            await NotificationSvc.NotifyCommentAsync(commenter.DisplayName ?? commenter.Email ?? "Someone", dilemma, currentUserId);

        await LoadDilemma();
        isBusy = false;
        StateHasChanged();
    }

    private void CancelReply()
    {
        replyingToCommentId = null;
        replyingToUsername = "";
        newComment = "";
    }

    private void StartEditComment(Guid commentId, string body)
    {
        editingCommentId = commentId;
        editingCommentBody = body;
        confirmDeleteCommentId = null;
        activeCommentReplyId = null;
    }

    private void CancelEditComment()
    {
        editingCommentId = null;
        editingCommentBody = "";
    }

    private async Task SaveCommentEdit(Guid commentId, string newBody)
    {
        var entry = await Db.Comments.FindAsync(commentId);
        if (entry != null && entry.UserId == currentUserId)
        {
            entry.Body = newBody.Trim();
            entry.EditedAt = DateTime.UtcNow;
            await Db.SaveChangesAsync();
        }
        editingCommentId = null;
        editingCommentBody = "";
        await LoadDilemma();
        StateHasChanged();
    }

    private async Task DeleteCommentWithReplies(Guid commentId)
    {
        var allComments = dilemma!.Comments.ToList();
        var toDelete = CollectDescendants(allComments, commentId);
        var target = allComments.FirstOrDefault(c => c.Id == commentId);
        if (target != null && target.UserId == currentUserId)
            toDelete.Add(target);
        Db.Comments.RemoveRange(toDelete);
        await Db.SaveChangesAsync();
        confirmDeleteCommentId = null;
        await LoadDilemma();
        StateHasChanged();
    }

    private List<Comment> CollectDescendants(List<Comment> all, Guid parentId)
    {
        var result = new List<Comment>();
        foreach (var child in all.Where(c => c.ParentCommentId == parentId))
        {
            result.Add(child);
            result.AddRange(CollectDescendants(all, child.Id));
        }
        return result;
    }

    private (string label, string css) GetVoteBadge(string? userId)
    {
        if (userId == null) return ("", "");
        if (userId == dilemma?.UserId) return ("✍️ Posted this", "badge-poster");
        if (commenterVotes.TryGetValue(userId, out var opt)) return ($"🗳️ {opt}", "badge-voted");
        return ("👀 Hasn't voted", "badge-novote");
    }

    private bool HasVoted() =>
        dilemma?.Options.Any(o => userVotedOptionIds.Contains(o.Id)) ?? false;

    private bool IsExpired() =>
        dilemma?.ExpiresAt.HasValue == true && dilemma.ExpiresAt!.Value < DateTime.UtcNow;

    private string GetTimeLeft(DateTime? expiresAt)
    {
        if (!expiresAt.HasValue) return "No limit";
        var diff = expiresAt.Value - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero) return "Expired";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m left";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h left";
        return $"{(int)diff.TotalDays}d left";
    }

    private bool _recentsRecorded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_recentsRecorded || dilemma == null || string.IsNullOrEmpty(dilemma.Category)) return;
        var cat = categories.FirstOrDefault(c => c.Value == dilemma.Category);
        if (cat == null) return;
        _recentsRecorded = true;
        await JS.InvokeVoidAsync("addRecentGroup", cat.Value, cat.Label, cat.Icon);
        await RecentNotifier.NotifyVisitedAsync();
    }

    private string GetCategoryIcon(string? category) =>
        categories.FirstOrDefault(c => c.Value == category)?.Icon ?? "🤔";
}

