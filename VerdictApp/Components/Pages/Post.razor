@page "/post"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VerdictApp.Data
@using VerdictApp.Models
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject VerdictApp.Services.NotificationService NotificationSvc
@inject IWebHostEnvironment Env
@attribute [Authorize]

<div class="post-page">
    <div class="post-header">
        <div>
            <h1>Post a Dilemma</h1>
            <p>Ask the community to help you decide</p>
        </div>

        @if (currentUserId != null)
        {
            <div class="drafts-wrapper">
                <button class="drafts-toggle-btn" @onclick="() => showDraftsPanel = !showDraftsPanel">
                    📋 Drafts @(userDrafts.Count > 0 ? $"({userDrafts.Count})" : "")
                </button>

                @if (showDraftsPanel)
                {
                    <div class="drafts-panel">
                        @if (!userDrafts.Any())
                        {
                            <p class="drafts-empty">No saved drafts yet.</p>
                        }
                        else
                        {
                            @foreach (var d in userDrafts.OrderByDescending(d => d.SavedAt))
                            {
                                var isLoaded = loadedDraftId == d.Id;
                                <div class="draft-item @(isLoaded ? "loaded" : "")">
                                    <div class="draft-item-info">
                                        <span class="draft-item-title">@(string.IsNullOrWhiteSpace(d.Title) ? "Untitled draft" : d.Title)</span>
                                        <span class="draft-item-time">@FormatDraftAge(d.SavedAt)</span>
                                    </div>
                                    <div class="draft-item-actions">
                                        @if (!isLoaded)
                                        {
                                            <button class="draft-load-btn" @onclick="() => LoadDraft(d)">Load</button>
                                        }
                                        else
                                        {
                                            <span class="draft-loaded-badge">Loaded</span>
                                        }
                                        <button class="draft-delete-btn" @onclick="() => DeleteDraft(d.Id)">✕</button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (loadedDraftId.HasValue)
    {
        <div class="alert-draft">
            📝 Editing draft — changes save to this draft
            <button class="discard-draft-btn" @onclick="ClearForm">✕ Clear form</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(draftSavedMessage))
    {
        <div class="alert-draft-saved">@draftSavedMessage</div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert-error">@errorMessage</div>
    }

    <div class="post-form">

        <!-- Title -->
        <div class="form-group">
            <label>Your Dilemma <span class="required">*</span></label>
            <input type="text" @bind="title" placeholder="e.g. Should I quit my job to travel the world?" class="form-input" />
        </div>

        <!-- Description -->
        <div class="form-group">
            <label>More context <span class="muted">(optional)</span></label>
            <textarea @bind="description" placeholder="Give people more background so they can make a better decision..." class="form-textarea" rows="3"></textarea>
        </div>

        <!-- Category -->
        <div class="form-group">
            <label>Category <span class="required">*</span></label>
            <select class="form-control" @bind="selectedCategory">
                <option value="">-- Select a category --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Value">@cat.Icon @cat.Label</option>
                }
            </select>
        </div>

        <!-- Time limit -->
        <div class="form-group">
            <label>Time limit <span class="required">*</span></label>
            <div class="time-grid">
                @foreach (var t in timeLimits)
                {
                    <button type="button"
                            class="time-btn @(selectedHours == t.Hours ? "selected" : "")"
                            @onclick="() => selectedHours = t.Hours">
                        @t.Label
                    </button>
                }
            </div>
        </div>

        <!-- Options -->
        <div class="form-group">
            <label>Choices <span class="required">*</span> <span class="muted">(min 2, max 5)</span></label>
            @for (int i = 0; i < options.Count; i++)
            {
                var index = i;
                <div class="option-row">
                    <span class="option-letter">@((char)('A' + index))</span>
                    <input type="text" value="@options[index]" @oninput="@(e => options[index] = e.Value?.ToString() ?? string.Empty)" placeholder="@("Choice " + (char)('A' + index))" class="form-input" />
                    @if (options.Count > 2)
                    {
                        <button type="button" class="remove-btn" @onclick="() => RemoveOption(index)">✕</button>
                    }
                </div>
            }
            @if (options.Count < 5)
            {
                <button type="button" class="add-option-btn" @onclick="AddOption">
                    + Add another choice
                </button>
            }
        </div>

        <!-- Image -->
        <div class="form-group">
            <label>Images <span class="muted">(optional · up to 4 · max 5 MB each)</span></label>
            <div class="file-upload-area">
                <InputFile accept="image/*" OnChange="HandleFilesSelected" class="file-input" id="fileInput" multiple />
                <label for="fileInput" class="file-label">
                    @if (selectedImages.Count == 0)
                    {
                        <span>📷 Choose up to 4 images…</span>
                    }
                    else if (selectedImages.Count < MaxImages)
                    {
                        <span>📷 Add another image (@selectedImages.Count/@MaxImages)</span>
                    }
                    else
                    {
                        <span>📷 @MaxImages images selected (max reached)</span>
                    }
                </label>
                @if (selectedImages.Any())
                {
                    <div class="file-list">
                        @foreach (var img in selectedImages)
                        {
                            var captured = img;
                            <div class="file-chip">
                                <span>@img.Name (@((img.Size / 1024).ToString("N0")) KB)</span>
                                <button type="button" class="file-chip-remove" @onclick="() => RemoveSelectedImage(captured)">✕</button>
                            </div>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(imageError))
                {
                    <p class="image-error">@imageError</p>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button type="button" class="draft-btn" @onclick="SaveDraft" disabled="@isBusy">
                @(loadedDraftId.HasValue ? "💾 Update Draft" : "💾 Save Draft")
            </button>
            <button type="button" class="submit-btn" @onclick="HandleSubmit" disabled="@isBusy">
                @(isBusy ? "Posting..." : "Post Dilemma ⚖")
            </button>
        </div>

    </div>
</div>

@code {
    private string title = "";
    private string description = "";
    private string selectedCategory = "";
    private int selectedHours = 24;
    private List<string> options = new() { "", "" };
    private bool isBusy = false;
    private string successMessage = "";
    private string errorMessage = "";
    private string draftSavedMessage = "";
    private Guid? loadedDraftId;
    private List<VerdictApp.Models.Draft> userDrafts = new();
    private bool showDraftsPanel = false;
    private string? currentUserId;
    private record SelectedImage(string Name, long Size, string Ext, byte[] Data);
    private List<SelectedImage> selectedImages = new();
    private string imageError = "";

    private static readonly string[] AllowedExtensions = { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
    private const int MaxImages = 4;

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        imageError = "";
        foreach (var file in e.GetMultipleFiles(MaxImages))
        {
            if (selectedImages.Count >= MaxImages)
            {
                imageError = $"Maximum {MaxImages} images reached.";
                break;
            }
            if (selectedImages.Any(f => f.Name == file.Name && f.Size == file.Size))
                continue;
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (!AllowedExtensions.Contains(ext))
            {
                imageError = "Only image files are allowed (jpg, png, gif, webp).";
                continue;
            }
            if (file.Size > 5 * 1024 * 1024)
            {
                imageError = "Each image must be under 5 MB.";
                continue;
            }
            using var ms = new MemoryStream();
            await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
            selectedImages.Add(new(file.Name, file.Size, ext, ms.ToArray()));
        }
        StateHasChanged();
    }

    private void RemoveSelectedImage(SelectedImage img)
    {
        selectedImages.Remove(img);
        imageError = "";
    }

    private async Task<List<string>> SaveImagesAsync(Guid dilemmaId)
    {
        var paths = new List<string>();
        if (!selectedImages.Any()) return paths;
        var uploadsDir = Path.Combine(Env.WebRootPath, "uploads");
        Directory.CreateDirectory(uploadsDir);
        for (int i = 0; i < selectedImages.Count; i++)
        {
            var img = selectedImages[i];
            var fileName = i == 0 ? $"{dilemmaId}{img.Ext}" : $"{dilemmaId}_{i}{img.Ext}";
            await File.WriteAllBytesAsync(Path.Combine(uploadsDir, fileName), img.Data);
            paths.Add($"/uploads/{fileName}");
        }
        return paths;
    }

    private record CategoryOption(string Value, string Label, string Icon);
    private record TimeLimit(int Hours, string Label);

    private List<CategoryOption> categories = new()
    {
        new("life",     "Life",      "🌱"),
        new("career",   "Career",    "💼"),
        new("finance",  "Finance",   "💰"),
        new("relationships", "Relationships", "❤️"),
        new("travel",   "Travel",    "✈️"),
        new("health",   "Health",    "🏃"),
        new("tech",     "Tech",      "💻"),
        new("other",    "Other",     "🤔"),
    };

    protected override async Task OnInitializedAsync()
    {
        var customCommunities = await Db.Communities.OrderBy(c => c.Name).ToListAsync();
        foreach (var c in customCommunities)
            categories.Add(new(c.Slug, c.Name, c.Icon));

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        currentUserId = user?.Id;

        if (currentUserId != null)
            userDrafts = await Db.Drafts
                .Where(d => d.UserId == currentUserId)
                .OrderByDescending(d => d.SavedAt)
                .ToListAsync();
    }

    private void LoadDraft(VerdictApp.Models.Draft d)
    {
        title = d.Title;
        description = d.Description;
        selectedCategory = d.Category;
        selectedHours = d.ExpiresAtHours;
        var saved = System.Text.Json.JsonSerializer.Deserialize<List<string>>(d.OptionsJson);
        if (saved != null && saved.Count >= 2) options = saved;
        loadedDraftId = d.Id;
        showDraftsPanel = false;
        errorMessage = "";
        successMessage = "";
    }

    private void ClearForm()
    {
        title = "";
        description = "";
        selectedCategory = "";
        selectedHours = 24;
        options = new() { "", "" };
        loadedDraftId = null;
    }

    private async Task SaveDraft()
    {
        if (currentUserId == null) return;
        isBusy = true;
        draftSavedMessage = "";

        var optionsJson = System.Text.Json.JsonSerializer.Serialize(options);

        if (loadedDraftId.HasValue)
        {
            var draft = await Db.Drafts.FindAsync(loadedDraftId.Value);
            if (draft != null)
            {
                draft.Title = title;
                draft.Description = description;
                draft.Category = selectedCategory;
                draft.ExpiresAtHours = selectedHours;
                draft.OptionsJson = optionsJson;
                draft.SavedAt = DateTime.UtcNow;
                var idx = userDrafts.FindIndex(d => d.Id == draft.Id);
                if (idx >= 0) userDrafts[idx] = draft;
            }
        }
        else
        {
            var draft = new VerdictApp.Models.Draft
            {
                Id = Guid.NewGuid(),
                UserId = currentUserId,
                Title = title,
                Description = description,
                Category = selectedCategory,
                ExpiresAtHours = selectedHours,
                OptionsJson = optionsJson,
                SavedAt = DateTime.UtcNow
            };
            loadedDraftId = draft.Id;
            Db.Drafts.Add(draft);
            userDrafts.Insert(0, draft);
        }

        await Db.SaveChangesAsync();
        isBusy = false;
        draftSavedMessage = "✓ Draft saved";
        StateHasChanged();
        await Task.Delay(2500);
        draftSavedMessage = "";
    }

    private async Task DeleteDraft(Guid draftId)
    {
        var draft = await Db.Drafts.FindAsync(draftId);
        if (draft != null) Db.Drafts.Remove(draft);
        await Db.SaveChangesAsync();
        userDrafts.RemoveAll(d => d.Id == draftId);
        if (loadedDraftId == draftId) ClearForm();
        if (!userDrafts.Any()) showDraftsPanel = false;
    }

    private string FormatDraftAge(DateTime savedAt)
    {
        var diff = DateTime.UtcNow - savedAt;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalHours < 1)   return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1)    return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }

    private List<TimeLimit> timeLimits = new()
    {
        new(1,   "1 hour"),
        new(6,   "6 hours"),
        new(24,  "24 hours"),
        new(72,  "3 days"),
        new(168, "1 week"),
    };

    private void AddOption() => options.Add("");
    private void RemoveOption(int index) => options.RemoveAt(index);

    private async Task HandleSubmit()
    {
        errorMessage = "";
        successMessage = "";

        // Validation
        if (string.IsNullOrWhiteSpace(title))
        {
            errorMessage = "Please enter your dilemma.";
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedCategory))
        {
            errorMessage = "Please select a category.";
            return;
        }
        var validOptions = options.Where(o => !string.IsNullOrWhiteSpace(o)).ToList();
        if (validOptions.Count < 2)
        {
            errorMessage = "Please enter at least 2 choices.";
            return;
        }

        isBusy = true;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user == null)
        {
            errorMessage = "You must be logged in to post.";
            isBusy = false;
            return;
        }

        var dilemma = new Dilemma
        {
            Id = Guid.NewGuid(),
            UserId = user.Id,
            Title = title,
            Description = description,
            Category = selectedCategory,
            ExpiresAt = DateTime.UtcNow.AddHours(selectedHours),
            CreatedAt = DateTime.UtcNow,
            Options = validOptions.Select(o => new DilemmaOption
            {
                Id = Guid.NewGuid(),
                OptionText = o
            }).ToList()
        };

        var imagePaths = await SaveImagesAsync(dilemma.Id);
        if (imagePaths.Any())
            dilemma.ImagePaths = System.Text.Json.JsonSerializer.Serialize(imagePaths);
        Db.Dilemmas.Add(dilemma);
        await Db.SaveChangesAsync();

        await NotificationSvc.NotifyNewPostAsync(dilemma, user.Id);

        if (loadedDraftId.HasValue)
        {
            var draft = await Db.Drafts.FindAsync(loadedDraftId.Value);
            if (draft != null) Db.Drafts.Remove(draft);
            await Db.SaveChangesAsync();
        }

        isBusy = false;
        Nav.NavigateTo("/");
    }
}

<style>
    .post-page {
        max-width: 680px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: Georgia, serif;
    }

    .post-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .post-header h1 {
        margin: 0;
        font-size: 2rem;
    }

    .post-header p {
        color: #888;
        margin: 0.25rem 0 0;
    }

    .drafts-wrapper {
        position: relative;
        flex-shrink: 0;
    }

    .drafts-toggle-btn {
        padding: 0.45rem 1rem;
        background: white;
        border: 1px solid #d0d5dd;
        border-radius: 20px;
        font-size: 0.85rem;
        font-family: Georgia, serif;
        cursor: pointer;
        color: #444;
        transition: all 0.15s;
        white-space: nowrap;
    }

    .drafts-toggle-btn:hover { border-color: #052767; color: #052767; background: #f0f4ff; }

    .drafts-panel {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        width: 280px;
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.1);
        z-index: 30;
        overflow: hidden;
    }

    .drafts-empty {
        padding: 1rem;
        font-size: 0.85rem;
        color: #aaa;
        text-align: center;
        font-style: italic;
        margin: 0;
    }

    .draft-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.65rem 0.85rem;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.12s;
    }

    .draft-item:last-child { border-bottom: none; }
    .draft-item:hover { background: #fafafa; }
    .draft-item.loaded { background: #f0f4ff; }

    .draft-item-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .draft-item-title {
        font-size: 0.88rem;
        font-weight: 600;
        color: #222;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .draft-item-time {
        font-size: 0.75rem;
        color: #aaa;
    }

    .draft-item-actions {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-shrink: 0;
    }

    .draft-load-btn {
        padding: 0.25rem 0.65rem;
        background: #052767;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 0.78rem;
        font-family: Georgia, serif;
        cursor: pointer;
    }

    .draft-load-btn:hover { background: #3a0647; }

    .draft-loaded-badge {
        font-size: 0.75rem;
        color: #052767;
        font-weight: 600;
    }

    .draft-delete-btn {
        background: none;
        border: none;
        color: #ccc;
        cursor: pointer;
        font-size: 0.8rem;
        padding: 0.2rem;
        line-height: 1;
    }

    .draft-delete-btn:hover { color: #e06c75; }

    .post-form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form-group label {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .required { color: #e06c75; }
    .muted    { color: #aaa; font-weight: normal; font-size: 0.85rem; }

    .form-input {
        padding: 0.65rem 0.9rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        font-family: Georgia, serif;
        transition: border-color 0.2s;
        width: 100%;
        box-sizing: border-box;
    }

    .form-input:focus {
        outline: none;
        border-color: #052767;
    }

    .form-textarea {
        padding: 0.65rem 0.9rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        font-family: Georgia, serif;
        resize: vertical;
        width: 100%;
        box-sizing: border-box;
        transition: border-color 0.2s;
    }

    .form-textarea:focus {
        outline: none;
        border-color: #052767;
    }

    /* Category grid */
    .category-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
    }

    .category-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        padding: 0.65rem 0.5rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: white;
        cursor: pointer;
        font-size: 0.82rem;
        transition: all 0.15s;
    }

    .category-btn:hover  { border-color: #052767; background: #f0f4ff; }
    .category-btn.selected { border-color: #052767; background: #052767; color: white; }
    .cat-icon { font-size: 1.3rem; }

    /* Time grid */
    .time-grid {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .time-btn {
        padding: 0.5rem 1rem;
        border: 1px solid #ddd;
        border-radius: 20px;
        background: white;
        cursor: pointer;
        font-size: 0.88rem;
        transition: all 0.15s;
    }

    .time-btn:hover   { border-color: #052767; background: #f0f4ff; }
    .time-btn.selected { border-color: #052767; background: #052767; color: white; }

    /* Options */
    .option-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .option-letter {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #052767;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .remove-btn {
        background: none;
        border: none;
        color: #aaa;
        cursor: pointer;
        font-size: 1rem;
        padding: 0.25rem;
        transition: color 0.2s;
    }

    .remove-btn:hover { color: #e06c75; }

    .add-option-btn {
        background: none;
        border: 1px dashed #ccc;
        border-radius: 8px;
        padding: 0.6rem;
        width: 100%;
        cursor: pointer;
        color: #888;
        font-size: 0.9rem;
        transition: all 0.2s;
        margin-top: 0.25rem;
    }

    .add-option-btn:hover { border-color: #052767; color: #052767; }

    /* Actions row */
    .form-actions {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .draft-btn {
        flex: 1;
        padding: 0.9rem;
        background: white;
        color: #052767;
        border: 2px solid #052767;
        border-radius: 8px;
        font-size: 1rem;
        font-family: Georgia, serif;
        cursor: pointer;
        transition: all 0.2s;
    }

    .draft-btn:hover:not(:disabled) { background: #f0f4ff; }
    .draft-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* Draft banners */
    .alert-draft {
        background: #fff8e1;
        color: #7a5800;
        border: 1px solid #ffe082;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }

    .discard-draft-btn {
        background: none;
        border: 1px solid #c8a400;
        border-radius: 20px;
        padding: 0.2rem 0.7rem;
        font-size: 0.8rem;
        color: #7a5800;
        cursor: pointer;
        white-space: nowrap;
        font-family: Georgia, serif;
    }

    .discard-draft-btn:hover { background: #ffe082; }

    .alert-draft-saved {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.5rem;
    }

    /* Submit */
    .submit-btn {
        flex: 1;
        padding: 0.9rem;
        background: #052767;
        color: white;
        border: none;
        border-radius: 8px;
