@page "/register"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using VerdictApp.Data
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Register</PageTitle>
<h3>Register</h3>

@if (isAuthed)
{
    <p>You're already signed in.</p>
    <a href="/">Go home</a>
}
else
{
    <EditForm Model="@model" OnValidSubmit="@HandleRegister" FormName="RegisterForm">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div style="margin-bottom:8px;">
            <label>Email</label><br />
            <InputText @bind-Value="model.Email" style="width:300px;" />
        </div>

        <div style="margin-bottom:8px;">
            <label>Username</label><br />
            <InputText @bind-Value="model.DisplayName" style="width:300px;" />
        </div>

        <div style="margin-bottom:8px;">
            <label>Password</label><br />
            <div style="position:relative; width:300px;">
                <InputText type="@PasswordInputType"
                           @bind-Value="model.Password"
                           class="form-control"
                           style="padding-right:30px;" />
                <button type="button"
                        style="position:absolute; right:0px; top:50%; transform:translateY(-50%); background:transparent; border:none;"
                        @onclick="TogglePassword">
                    <img src="@EyeIcon" width="20" />
                </button>
            </div>
        </div>

        <div style="margin-bottom:8px;">
            <label>Confirm Password</label><br />
            <InputText type="password" @bind-Value="model.ConfirmPassword" style="width:300px;" />
        </div>

        <button type="submit" disabled="@isBusy">Create account</button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <p style="color:red">@error</p>
    }
}

<p>
    Already have an account?
    <a href="/login">Login</a>
</p>

@code {
    public RegisterModel model { get; set; } = new();

    private string? error;
    private bool isBusy;
    private bool isAuthed;
    bool showPassword = false;
    string PasswordInputType => showPassword ? "text" : "password";
    string EyeIcon => showPassword ? "icons/hide.png" : "icons/view.png";
    void TogglePassword() => showPassword = !showPassword;

    private async Task HandleRegister()
    {
        error = null;
        isBusy = true;

        var user = new ApplicationUser
        {
            UserName = model.Email,
            Email = model.Email,
            DisplayName = model.DisplayName  // add this
        };

        var result = await UserManager.CreateAsync(user, model.Password);
        if (!result.Succeeded)
        {
            error = string.Join(" | ", result.Errors.Select(e => e.Description));
            isBusy = false;
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: true);
        Nav.NavigateTo("/");
    }

    public class RegisterModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [Display(Name = "Username")]
        [MinLength(3, ErrorMessage = "Username must be at least 3 characters")]
        public string DisplayName { get; set; } = "";

        [Required, MinLength(8)]
        public string Password { get; set; } = "";

        [Required, Compare(nameof(Password))]
        public string ConfirmPassword { get; set; } = "";
    }
}