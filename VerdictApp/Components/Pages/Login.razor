@page "/login"
@* @rendermode InteractiveServer *@
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using VerdictApp.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<h3>Login</h3>

<EditForm Model="@model" OnValidSubmit="@HandleLogin" FormName="LoginForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div style="margin-bottom:8px;">
        <label>Email</label><br />
        <InputText @bind-Value="model.Email" />
    </div>

    <div style="margin-bottom:8px; position:relative;">
    <label>Password</label><br />
    <InputText type="@passwordInputType" @bind-Value="model.Password" />
    <button type="button" @onclick="TogglePassword" class="eye-btn">
        @if (showPassword)
        {
            <span>🙈</span>
        }
        else
        {
            <span>👁</span>
        }
    </button>
</div>

    <div style="margin-bottom:12px;">
        <InputCheckbox @bind-Value="model.RememberMe" />
        <label style="margin-left:6px;">Remember me</label>
    </div>

    <button type="submit" disabled="@isBusy">Login</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(error))
{
    <p style="color:red">@error</p>
}

<p>
    No account?
    <a href="/register">Register</a>
</p>

@code {
    [SupplyParameterFromForm(FormName = "LoginForm")]
    @* private LoginModel model = new(); *@
    public LoginModel model { get; set;} = new();
    private string? error;
    private bool isBusy;
    private bool showPassword = false;
    private string passwordInputType => showPassword ? "text" : "password";
    private void TogglePassword() => showPassword = !showPassword;

    private async Task HandleLogin()
    {
        error = null;
        isBusy = true;

        var result = await SignInManager.PasswordSignInAsync(
            model.Email,
            model.Password,
            isPersistent: model.RememberMe,
            lockoutOnFailure: false);

        if (result.Succeeded)
        {
            Nav.NavigateTo("/");
        }
        else
        {
            error = "Invalid email or password.";
        }

        isBusy = false;

    }

    public class LoginModel
    {
        [Required, EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = true;
    }
}