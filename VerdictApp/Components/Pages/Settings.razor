@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VerdictApp.Data
@using VerdictApp.Models
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject IWebHostEnvironment Env
@inject VerdictApp.Services.SupabaseAuthService SupabaseAuth
@inject VerdictApp.Services.EmailSender EmailSender
@attribute [Authorize]

<PageTitle>Settings</PageTitle>

@if (user == null)
{
    <p>Loading...</p>
}
else
{
    <div class="settings-page">

        <div class="settings-header">
            <a href="/profile" class="back-link">&#8592; Profile</a>
            <h1>Settings</h1>
        </div>

        <div class="stab-bar">
            <button class="@StabClass("profile")"  @onclick='() => Switch("profile")'>Profile</button>
            <button class="@StabClass("privacy")"  @onclick='() => Switch("privacy")'>Privacy</button>
            <button class="@StabClass("security")" @onclick='() => Switch("security")'>Security</button>
            <button class="@StabClass("account")"  @onclick='() => Switch("account")'>Account</button>
        </div>

        @if (activeTab == "profile")
        {
            <div class="settings-section">

                <div class="photo-row">
                    @if (!string.IsNullOrWhiteSpace(user.ProfilePhotoPath))
                    {
                        <img src="@user.ProfilePhotoPath" class="avatar-preview" />
                    }
                    else
                    {
                        <div class="avatar-preview avatar-initials">@user.DisplayName![0].ToString().ToUpper()</div>
                    }
                    <div style="display:flex; flex-direction:row; align-items:center; gap:0.75rem; flex-wrap:wrap;">
                        <label class="upload-btn">
                            Change photo
                            <InputFile OnChange="HandlePhoto" accept="image/*" style="display:none" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(user.ProfilePhotoPath))
                        {
                            <button class="remove-photo-btn" @onclick="RemovePhoto" disabled="@isBusy">Remove photo</button>
                        }
                        @if (!string.IsNullOrWhiteSpace(photoError)) { <p class="msg error">@photoError</p> }
                    </div>
                </div>

                <div class="form-group">
                    <label>Username</label>
                    <input @bind="newDisplayName" class="form-control" placeholder="@user.DisplayName" />
                </div>

                <div class="form-group">
                    <label>Bio</label>
                    <textarea @bind="newBio" class="form-control" rows="3" placeholder="Tell people a bit about yourself…"></textarea>
                </div>

                @if (!string.IsNullOrWhiteSpace(profileError))   { <p class="msg error">@profileError</p> }
                @if (!string.IsNullOrWhiteSpace(profileSuccess)) { <p class="msg success">@profileSuccess</p> }
                <button class="btn-primary" @onclick="SaveProfile" disabled="@isBusy">Save</button>

            </div>
        }

        @if (activeTab == "privacy")
        {
            <div class="settings-section">
                <p class="section-desc">Control what others can see when they visit your profile.</p>

                <div class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Hide my posts</span>
                        <span class="toggle-hint">Others cannot see the dilemmas you've posted.</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="hidePostsFromProfile" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                <div class="toggle-row">
                    <div class="toggle-info">
                        <span class="toggle-label">Hide my comments</span>
                        <span class="toggle-hint">Others cannot see your comments on dilemmas.</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="hideCommentsFromProfile" />
                        <span class="toggle-slider"></span>
                    </label>
                </div>

                @if (!string.IsNullOrWhiteSpace(privacySuccess)) { <p class="msg success">@privacySuccess</p> }
                <button class="btn-primary" @onclick="SavePrivacy" disabled="@isBusy">Save</button>
            </div>
        }

        @if (activeTab == "security")
        {
            <div class="settings-section">

                @if (!showPasswordForm)
                {
                    <button class="btn-primary" @onclick='() => { showPasswordForm = true; passwordSuccess = null; }'>Change password</button>
                    @if (!string.IsNullOrWhiteSpace(passwordSuccess)) { <p class="msg success">@passwordSuccess</p> }
                }
                else
                {
                    <div class="form-group">
                        <label>Current password</label>
                        <input type="password" @bind="currentPassword" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>New password</label>
                        <input type="password" @bind="newPassword" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>Confirm new password</label>
                        <input type="password" @bind="confirmPassword" class="form-control" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(passwordError)) { <p class="msg error">@passwordError</p> }
                    <div class="action-row">
                        <button class="btn-primary" @onclick="ChangePassword" disabled="@isBusy">Update password</button>
                        <button class="btn-secondary" @onclick='() => { showPasswordForm = false; currentPassword = newPassword = confirmPassword = string.Empty; passwordError = null; }'>Cancel</button>
                    </div>
                }

            </div>
        }

        @if (activeTab == "account")
        {
            <div class="settings-section danger-zone">

                <p class="danger-desc">Permanently deletes your account and all data. This cannot be undone.</p>

                @if (!confirmDelete)
                {
                    <button class="btn-danger" @onclick='() => confirmDelete = true'>Delete my account</button>
                }
                else
                {
                    <div class="form-group">
                        <label>Enter your password to confirm</label>
                        <input type="password" @bind="deletePassword" class="form-control" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(deleteError)) { <p class="msg error">@deleteError</p> }
                    <div class="action-row">
                        <button class="btn-danger" @onclick="DeleteAccount" disabled="@isBusy">Confirm delete</button>
                        <button class="btn-secondary" @onclick='() => { confirmDelete = false; deletePassword = string.Empty; deleteError = null; }'>Cancel</button>
                    </div>
                }

            </div>
        }

    </div>
}

@code {
    private ApplicationUser? user;
    private bool isBusy;
    private string activeTab = "profile";

    // Profile tab
    private string  newDisplayName = string.Empty;
    private string  newBio         = string.Empty;
    private string? profileError;
    private string? profileSuccess;
    private string? photoError;

    // Security tab
    private bool   showPasswordForm;
    private string currentPassword = string.Empty;
    private string newPassword     = string.Empty;
    private string confirmPassword = string.Empty;
    private string? passwordError;
    private string? passwordSuccess;

    // Privacy tab
    private bool    hidePostsFromProfile;
    private bool    hideCommentsFromProfile;
    private string? privacySuccess;

    // Account tab
    private bool    confirmDelete;
    private string  deletePassword = string.Empty;
    private string? deleteError;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        user = await UserManager.GetUserAsync(authState.User);
        if (user != null)
        {
            newDisplayName         = user.DisplayName ?? string.Empty;
            newBio                 = user.Bio         ?? string.Empty;
            hidePostsFromProfile    = user.HidePostsFromProfile;
            hideCommentsFromProfile = user.HideCommentsFromProfile;
        }
    }

    private void Switch(string tab)
    {
        activeTab        = tab;
        profileError     = profileSuccess = passwordError = passwordSuccess = photoError = deleteError = privacySuccess = null;
        confirmDelete    = false;
        showPasswordForm = false;
    }

    private async Task SavePrivacy()
    {
        isBusy = true;
        user!.HidePostsFromProfile    = hidePostsFromProfile;
        user!.HideCommentsFromProfile = hideCommentsFromProfile;
        await UserManager.UpdateAsync(user);
        privacySuccess = "Privacy settings saved.";
        isBusy = false;
    }

    private async Task HandlePhoto(InputFileChangeEventArgs e)
    {
        photoError = null;
        var file = e.File;
        if (file.Size > 5 * 1024 * 1024)
        {
            photoError = "Photo must be under 5 MB.";
            return;
        }

        var ext      = Path.GetExtension(file.Name).ToLowerInvariant();
        var allowed  = new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
        if (!allowed.Contains(ext))
        {
            photoError = "Please upload a JPG, PNG, GIF, or WebP image.";
            return;
        }

        var dir      = Path.Combine(Env.WebRootPath, "uploads", "avatars");
        var fileName = $"{user!.Id}{ext}";
        var filePath = Path.Combine(dir, fileName);

        await using var stream = new FileStream(filePath, FileMode.Create);
        await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(stream);

        user.ProfilePhotoPath = $"/uploads/avatars/{fileName}";
        await UserManager.UpdateAsync(user);
    }

    private async Task RemovePhoto()
    {
        photoError = null;
        if (string.IsNullOrWhiteSpace(user!.ProfilePhotoPath)) return;

        var filePath = Path.Combine(Env.WebRootPath, user.ProfilePhotoPath.TrimStart('/'));
        if (File.Exists(filePath)) File.Delete(filePath);

        user.ProfilePhotoPath = null;
        await UserManager.UpdateAsync(user);
    }

    private async Task SaveProfile()
    {
        profileError = null;
        profileSuccess = null;

        if (string.IsNullOrWhiteSpace(newDisplayName) || newDisplayName.Length < 3)
        {
            profileError = "Username must be at least 3 characters.";
            return;
        }

        var taken = UserManager.Users.Any(u => u.DisplayName!.ToLower() == newDisplayName.ToLower() && u.Id != user!.Id);
        if (taken)
        {
            profileError = "That username is already taken.";
            return;
        }

        isBusy = true;
        user!.DisplayName = newDisplayName;
        user.Bio          = newBio;
        var result = await UserManager.UpdateAsync(user);
        isBusy = false;

        if (result.Succeeded)
            profileSuccess = "Profile saved.";
        else
            profileError = string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private async Task ChangePassword()
    {
        passwordError = null;
        passwordSuccess = null;

        if (string.IsNullOrWhiteSpace(currentPassword) || string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            passwordError = "Please fill in all fields.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            passwordError = "New passwords do not match.";
            return;
        }

        isBusy = true;
        var result = await UserManager.ChangePasswordAsync(user!, currentPassword, newPassword);
        isBusy = false;

        if (result.Succeeded)
        {
            // Sync Supabase Auth password and send the notification email
            await SupabaseAuth.UpdatePasswordAsync(user!.Email!, currentPassword, newPassword);
            await EmailSender.SendPasswordChangedAsync(user!, user!.Email!);
            passwordSuccess      = "Password updated.";
            currentPassword      = newPassword = confirmPassword = string.Empty;
            showPasswordForm     = false;
        }
        else
        {
            passwordError = string.Join(" ", result.Errors.Select(e => e.Description));
        }
    }

    private async Task DeleteAccount()
    {
        deleteError = null;

        if (string.IsNullOrWhiteSpace(deletePassword))
        {
            deleteError = "Please enter your password.";
            return;
        }
        if (!await UserManager.CheckPasswordAsync(user!, deletePassword))
        {
            deleteError = "Incorrect password.";
            return;
        }

        isBusy = true;
        var userId = user!.Id;

        var dilemmaIds = await Db.Dilemmas
            .Where(d => d.UserId == userId).Select(d => d.Id).ToListAsync();

        var optionIds = await Db.DilemmaOptions
            .Where(o => dilemmaIds.Contains(o.DilemmaId)).Select(o => o.Id).ToListAsync();

        var convIds = await Db.Conversations
            .Where(c => c.InitiatorId == userId || c.RecipientId == userId)
            .Select(c => c.Id).ToListAsync();

        Db.Votes.RemoveRange(
            Db.Votes.Where(v => v.UserId == userId || optionIds.Contains(v.DilemmaOptionId)));
        Db.Comments.RemoveRange(
            Db.Comments.Where(c => c.UserId == userId || dilemmaIds.Contains(c.DilemmaId)));
        Db.Notifications.RemoveRange(
            Db.Notifications.Where(n => n.RecipientUserId == userId ||
                (n.DilemmaId.HasValue && dilemmaIds.Contains(n.DilemmaId!.Value))));
        Db.CategorySubscriptions.RemoveRange(
            Db.CategorySubscriptions.Where(s => s.UserId == userId));
        Db.DirectMessages.RemoveRange(
            Db.DirectMessages.Where(m => convIds.Contains(m.ConversationId)));
        Db.Conversations.RemoveRange(
            Db.Conversations.Where(c => convIds.Contains(c.Id)));
        Db.DilemmaOptions.RemoveRange(
            Db.DilemmaOptions.Where(o => dilemmaIds.Contains(o.DilemmaId)));
        Db.Dilemmas.RemoveRange(
            Db.Dilemmas.Where(d => dilemmaIds.Contains(d.Id)));

        await Db.SaveChangesAsync();
        var emailToDelete = user!.Email!;
        await UserManager.DeleteAsync(user!);
        // Remove the Supabase Auth record so the email can be re-registered
        await SupabaseAuth.DeleteUserAsync(emailToDelete);

        Nav.NavigateTo("/account/logout", forceLoad: true);
    }

    private string StabClass(string tab) => "stab " + (activeTab == tab ? "active" : "");
}

<style>
    .settings-page {
        max-width: 520px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: Georgia, serif;
    }

    .settings-header {
        margin-bottom: 1.25rem;
    }

    .back-link {
        font-size: 0.9rem;
        color: #888;
        text-decoration: none;
    }

    .back-link:hover { color: #052767; }

    .settings-header h1 {
        margin: 0.3rem 0 0;
        font-size: 1.6rem;
    }

    .stab-bar {
        display: flex;
        border-bottom: 2px solid #e0e0e0;
        margin-bottom: 1.25rem;
        gap: 0.25rem;
    }

    .stab {
        background: none;
        border: none;
        padding: 0.5rem 1rem;
        cursor: pointer;
        font-size: 0.9rem;
        color: #666;
        border-bottom: 3px solid transparent;
        margin-bottom: -2px;
        font-family: inherit;
        transition: color 0.15s, border-color 0.15s;
    }

    .stab.active {
        color: #052767;
        border-bottom-color: #052767;
        font-weight: 600;
    }

    .settings-section {
        border: 1px solid #e8e8e8;
        border-radius: 10px;
        padding: 1.25rem;
    }

    .photo-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .avatar-preview {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        object-fit: cover;
    }

    .avatar-initials {
        background: linear-gradient(135deg, #052767, #3a0647);
        color: white;
        font-size: 1.6rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .upload-btn {
        display: inline-block;
        padding: 0.4rem 0.9rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        color: #444;
        font-family: Georgia, serif;
        transition: border-color 0.15s;
    }

    .upload-btn:hover { border-color: #052767; color: #052767; }

    .remove-photo-btn {
        display: inline-block;
        padding: 0.4rem 0.9rem;
        background: none;
        border: 1px solid #e0b0b0;
        border-radius: 6px;
        font-size: 0.85rem;
        cursor: pointer;
        color: #c0392b;
        font-family: Georgia, serif;
        transition: border-color 0.15s, color 0.15s;
    }

    .remove-photo-btn:hover:not(:disabled) { border-color: #c0392b; color: #a93226; }
    .remove-photo-btn:disabled { opacity: 0.6; cursor: default; }

    .form-group {
        margin-bottom: 0.8rem;
    }

    .form-group label {
        display: block;
        font-size: 0.85rem;
        color: #555;
        margin-bottom: 0.3rem;
    }

    .form-control {
        width: 100%;
        padding: 0.45rem 0.7rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 0.9rem;
        font-family: inherit;
        box-sizing: border-box;
        resize: vertical;
    }

    .form-control:focus {
        outline: none;
        border-color: #052767;
    }

    .msg { font-size: 0.83rem; margin: 0.4rem 0; }
    .msg.error   { color: #c0392b; }
    .msg.success { color: #27ae60; }

    .btn-primary {
        background: #052767;
        color: white;
        border: none;
        padding: 0.45rem 1.1rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.88rem;
        font-family: inherit;
        margin-top: 0.2rem;
        transition: background 0.2s;
    }

    .btn-primary:hover:not(:disabled) { background: #0a3d8f; }
    .btn-primary:disabled              { opacity: 0.6; cursor: default; }

    .danger-zone { border-color: #f5c6c6; }

    .danger-desc {
        font-size: 0.85rem;
        color: #888;
        margin: 0 0 0.9rem;
    }

    .btn-danger {
        background: #c0392b;
        color: white;
        border: none;
        padding: 0.45rem 1.1rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.88rem;
        font-family: inherit;
        transition: background 0.2s;
    }

    .btn-danger:hover:not(:disabled) { background: #a93226; }
    .btn-danger:disabled              { opacity: 0.6; cursor: default; }

    .btn-secondary {
        background: none;
        color: #666;
        border: 1px solid #ccc;
        padding: 0.45rem 1.1rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.88rem;
        font-family: inherit;
        transition: border-color 0.2s;
    }

    .btn-secondary:hover { border-color: #999; color: #333; }

    .action-row {
        display: flex;
        gap: 0.6rem;
        margin-top: 0.6rem;
    }

    .section-desc {
        font-size: 0.85rem;
        color: #888;
        margin: 0 0 1rem;
    }

    .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .toggle-row:last-of-type { border-bottom: none; margin-bottom: 0.75rem; }

    .toggle-info {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .toggle-label { font-size: 0.9rem; font-weight: 600; color: #333; }
    .toggle-hint  { font-size: 0.78rem; color: #aaa; }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 42px;
        height: 24px;
        flex-shrink: 0;
        cursor: pointer;
    }

    .toggle-switch input { opacity: 0; width: 0; height: 0; }

    .toggle-slider {
        position: absolute;
        inset: 0;
        background: #ccc;
        border-radius: 24px;
        transition: background 0.2s;
    }

    .toggle-slider::before {
        content: "";
        position: absolute;
        width: 18px;
        height: 18px;
        left: 3px;
        top: 3px;
        background: white;
        border-radius: 50%;
        transition: transform 0.2s;
    }

    .toggle-switch input:checked + .toggle-slider { background: #052767; }
    .toggle-switch input:checked + .toggle-slider::before { transform: translateX(18px); }
</style>
