@page "/logout"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Logout</PageTitle>

@if (!showConfirm)
{
    <p>Preparing logout...</p>
}
else
{
    <div class="logout-overlay">
        <div class="logout-popup">
            <h4>Confirm Logout</h4>
            <p>Are you sure you want to log out?</p>

            <button class="btn btn-danger" @onclick="ConfirmLogout">
                Yes, Logout
            </button>

            <button class="btn btn-secondary" @onclick="CancelLogout">
                Cancel
            </button>
        </div>
    </div>
}

@code {
    private bool showConfirm = true;

    private void ConfirmLogout()
    {
        // Redirect to a server endpoint that performs the logout.
        // We use forceLoad to perform a full page navigation so the authentication cookie is cleared server-side.
        Nav.NavigateTo("/account/logout", forceLoad: true);
    }

    private void CancelLogout()
    {
        // Navigate back to home if the user cancels
        Nav.NavigateTo("/");
    }
}