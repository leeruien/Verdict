@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VerdictApp.Data
@using VerdictApp.Models
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<div class="home-page">

    <div class="home-header">
        <h1>⚖ Verdict</h1>
        <p>Help others decide — vote on their dilemmas</p>
    </div>

    <div class="filter-bar">
        @foreach (var f in Filters)
        {
            <button class="filter-btn @(activeFilter == f.Key ? "active" : "")"
                    @onclick="() => SetFilter(f.Key)">
                @f.Value
            </button>
        }
    </div>

    @if (activeFilter == "following" && currentUserId == null)
    {
        <p class="empty-state"><a href="/login">Log in</a> to see posts from communities you follow.</p>
    }
    else if (dilemmas == null)
    {
        <p class="loading">Loading dilemmas...</p>
    }
    else if (!dilemmas.Any())
    {
        <p class="empty-state">
            @if (activeFilter == "following")
            {
                @:No posts from your subscribed communities yet. <a href="/explore">Explore communities</a>
            }
            else
            {
                @:No dilemmas yet. <a href="/post">Be the first to post one!</a>
            }
        </p>
    }
    else
    {
        @foreach (var dilemma in dilemmas)
        {
            var totalVotesOnCard = dilemma.Options.Sum(o => o.Votes.Count);
            var isOwner = dilemma.UserId == currentUserId;
            var expired = IsExpired(dilemma);
            var votedOnThis = HasVotedOnDilemma(dilemma);

            <div class="dilemma-card @(isOwner ? "own-post" : "")">

                <div class="dilemma-meta">
                    @if (isOwner)
                    {
                        <span class="your-post-badge">Your post</span>
                    }
                    @if (!string.IsNullOrEmpty(dilemma.Category))
                    {
                        <span class="category-tag">@GetCategoryIcon(dilemma.Category) @dilemma.Category</span>
                    }
                    <span class="time-left">⏱ @GetTimeLeft(dilemma.ExpiresAt)</span>
                </div>

                <h2 class="dilemma-title" style="cursor:pointer"
                    @onclick='() => Nav.NavigateTo($"/dilemma/{dilemma.Id}")'>
                    @dilemma.Title
                </h2>

                @if (!string.IsNullOrWhiteSpace(dilemma.Description))
                {
                    <p class="dilemma-desc">@dilemma.Description</p>
                }
                @if (dilemma.ImagePathList.Any())
                {
                    <img src="@dilemma.ImagePathList[0]" alt="Post image" class="card-image" />
                }

                <div class="options-list">
                    @foreach (var option in dilemma.Options)
                    {
                        var optionVotes = option.Votes.Count;
                        var percent = totalVotesOnCard > 0
                            ? (int)Math.Round((double)optionVotes / totalVotesOnCard * 100)
                            : 0;
                        var userVotedThis = userVotedOptionIds.Contains(option.Id);

                        <button class="option-btn @(userVotedThis ? "voted" : "") @(votedOnThis && !userVotedThis ? "dimmed" : "")"
                                @onclick="() => CastVote(dilemma, option)"
                                disabled="@(votedOnThis || isOwner || expired)">
                            <div class="option-content">
                                <span class="option-text">@option.OptionText</span>
                                @if (votedOnThis || isOwner || expired)
                                {
                                    <span class="option-percent">@percent%</span>
                                }
                            </div>
                            @if (votedOnThis || isOwner)
                            {
                                <div class="progress-bar">
                                    <div class="progress-fill @(userVotedThis || isOwner ? "fill-voted" : "")" style="width: @(percent)%"></div>
                                </div>
                            }
                        </button>
                    }
                </div>

                <div class="dilemma-footer">
                    <span>@totalVotesOnCard votes</span>
                    <span>@dilemma.Comments.Count comments</span>
                    @if (expired)
                    {
                        <span class="expired-tag">Expired</span>
                    }
                </div>

            </div>
        }
    }

</div>

@code {
    private List<Dilemma>? dilemmas;
    private string? currentUserId;
    private HashSet<Guid> userVotedOptionIds = new();
    private List<string> subscribedCategories = new();
    private string activeFilter = "all";

    private static readonly Dictionary<string, string> Filters = new()
    {
        ["all"]       = "All",
        ["following"] = "Following",
        ["popular"]   = "Popular",
        ["top"]       = "Top",
        ["hot"]       = "🔥 Hot",
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        currentUserId = user?.Id;

        if (currentUserId != null)
        {
            var myVotes = await Db.Votes
                .Where(v => v.UserId == currentUserId)
                .Select(v => v.DilemmaOptionId)
                .ToListAsync();
            userVotedOptionIds = myVotes.ToHashSet();

            subscribedCategories = await Db.CategorySubscriptions
                .Where(s => s.UserId == currentUserId)
                .Select(s => s.Category)
                .ToListAsync();
        }

        await LoadDilemmas();
    }

    private async Task SetFilter(string filter)
    {
        activeFilter = filter;
        await LoadDilemmas();
    }

    private async Task LoadDilemmas()
    {
        var query = Db.Dilemmas
            .Include(d => d.User)
            .Include(d => d.Options).ThenInclude(o => o.Votes)
            .Include(d => d.Comments)
            .AsQueryable();

        switch (activeFilter)
        {
            case "following":
                if (currentUserId == null) { dilemmas = new(); return; }
                dilemmas = await query
                    .Where(d => subscribedCategories.Contains(d.Category))
                    .OrderByDescending(d => d.CreatedAt)
                    .ToListAsync();
                break;

            case "popular":
                // All-time most voted — sorted in memory after fetch
                var all = await query.ToListAsync();
                dilemmas = all.OrderByDescending(d => d.Options.Sum(o => o.Votes.Count)).ToList();
                break;

            case "top":
                // Most voted in the last 7 days
                var cutoff = DateTime.UtcNow.AddDays(-7);
                var recent = await query.Where(d => d.CreatedAt >= cutoff).ToListAsync();
                dilemmas = recent.OrderByDescending(d => d.Options.Sum(o => o.Votes.Count)).ToList();
                break;

            case "hot":
                // Vote velocity: votes / (age_hours + 2)^1.5  (Reddit-style decay)
                var hotAll = await query.ToListAsync();
                dilemmas = hotAll.OrderByDescending(d =>
                {
                    var votes = d.Options.Sum(o => o.Votes.Count);
                    var ageHours = (DateTime.UtcNow - d.CreatedAt).TotalHours;
                    return votes / Math.Pow(ageHours + 2, 1.5);
                }).ToList();
                break;

            default: // "all" — newest first
                dilemmas = await query.OrderByDescending(d => d.CreatedAt).ToListAsync();
                break;
        }
    }

    private async Task CastVote(Dilemma dilemma, DilemmaOption option)
    {
        if (currentUserId == null) { Nav.NavigateTo("/login"); return; }
        if (HasVotedOnDilemma(dilemma)) return;
        if (IsExpired(dilemma)) return;

        var vote = new Vote
        {
            Id = Guid.NewGuid(),
            UserId = currentUserId,
            DilemmaOptionId = option.Id,
            CreatedAt = DateTime.UtcNow
        };

        Db.Votes.Add(vote);
        await Db.SaveChangesAsync();

        userVotedOptionIds.Add(option.Id);
        await LoadDilemmas();

        StateHasChanged();
    }

    private bool HasVotedOnDilemma(Dilemma dilemma) =>
        dilemma.Options.Any(o => userVotedOptionIds.Contains(o.Id));

    private bool IsExpired(Dilemma dilemma) =>
        dilemma.ExpiresAt.HasValue && dilemma.ExpiresAt.Value < DateTime.UtcNow;

    private string GetTimeLeft(DateTime? expiresAt)
    {
        if (!expiresAt.HasValue) return "No limit";
        var diff = expiresAt.Value - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero) return "Expired";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m left";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h left";
        return $"{(int)diff.TotalDays}d left";
    }

    private static readonly Dictionary<string, string> CategoryIcons = new()
    {
        ["life"] = "🌱", ["career"] = "💼", ["finance"] = "💰",
        ["relationships"] = "❤️", ["travel"] = "✈️", ["health"] = "🏃",
        ["tech"] = "💻", ["other"] = "🤔",
    };

    private string GetCategoryIcon(string? category) =>
        category != null && CategoryIcons.TryGetValue(category, out var icon) ? icon : "🤔";
}

<style>
    .home-page {
        max-width: 680px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: Georgia, serif;
    }

    .home-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .home-header h1 { font-size: 2rem; margin: 0; }
    .home-header p  { color: #888; margin: 0.25rem 0 0; }

    .filter-bar {
        display: flex;
        gap: 0.4rem;
        margin-bottom: 1.25rem;
        overflow-x: auto;
        padding-bottom: 2px;
        scrollbar-width: none;
    }

    .filter-bar::-webkit-scrollbar { display: none; }

    .filter-btn {
        flex-shrink: 0;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        padding: 0.4rem 0.9rem;
        font-size: 0.85rem;
        font-family: Georgia, serif;
        cursor: pointer;
        color: #555;
        transition: all 0.15s;
    }

    .filter-btn:hover { background: #e8ecf7; border-color: #c5d0ee; color: #052767; }

    .filter-btn.active {
        background: #052767;
        border-color: #052767;
        color: #fff;
        font-weight: 600;
    }

    .dilemma-card {
        border: 1px solid #e8e8e8;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        transition: box-shadow 0.2s;
    }

    .dilemma-card:hover   { box-shadow: 0 2px 16px rgba(0,0,0,0.08); }
    .dilemma-card.own-post { border-color: #052767; border-width: 2px; }

    .dilemma-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
    }

    .your-post-badge {
        background: #052767;
        color: white;
        font-size: 0.72rem;
        padding: 2px 8px;
        border-radius: 20px;
        font-weight: 600;
    }

    .category-tag {
        background: #f0f4ff;
        color: #052767;
        font-size: 0.78rem;
        padding: 2px 8px;
        border-radius: 20px;
        text-transform: capitalize;
    }

    .time-left {
        font-size: 0.78rem;
        color: #888;
        margin-left: auto;
    }

    .dilemma-title {
        font-size: 1.15rem;
        margin: 0 0 0.15rem;
        font-weight: 700;
    }

    .post-author {
        font-size: 0.78rem;
        color: #aaa;
        display: block;
        margin: -0.25rem 0 0.5rem;
    }

    .dilemma-desc {
        font-size: 0.9rem;
        color: #555;
        margin: 0 0 0.75rem;
    }

    .card-image {
        width: 100%;
        max-height: 220px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 0.75rem;
    }

    .options-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .option-btn {
        width: 100%;
        text-align: left;
        background: #f9f9f9;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 0.6rem 0.85rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .option-btn:hover:not(:disabled) { border-color: #052767; background: #f0f4ff; }
    .option-btn.voted   { border-color: #052767; background: #f0f4ff; }
    .option-btn.dimmed  { opacity: 0.6; }
    .option-btn:disabled { cursor: default; }

    .option-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .option-text    { font-size: 0.92rem; }
    .option-percent { font-size: 0.82rem; font-weight: 600; color: #052767; }

    .progress-bar {
        height: 3px;
        background: #e0e0e0;
        border-radius: 2px;
        margin-top: 0.4rem;
    }

    .progress-fill {
        height: 100%;
        background: #ccc;
        border-radius: 2px;
        transition: width 0.4s ease;
    }

    .fill-voted { background: #052767; }

    .dilemma-footer {
        display: flex;
        gap: 1rem;
        font-size: 0.8rem;
        color: #aaa;
        margin-top: 0.5rem;
    }

    .expired-tag {
        margin-left: auto;
        color: #e06c75;
        font-weight: 600;
    }

    .loading, .empty-state {
        text-align: center;
        color: #aaa;
        padding: 3rem 0;
        font-style: italic;
    }

    .empty-state a { color: #052767; }

    @@media (max-width: 480px) {
        .filter-bar { gap: 0.3rem; }
        .filter-btn { font-size: 0.75rem; padding: 0.35rem 0.65rem; }
    }
</style>
