@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VerdictApp.Data
@using VerdictApp.Models
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject ApplicationDbContext Db
@inject NavigationManager Nav

<div class="home-page">

    <div class="home-header">
        <h1>⚖ Verdict</h1>
        <p>Help others decide — vote on their dilemmas</p>
    </div>

    <div class="communities-section">
        <h2 class="communities-title">Communities</h2>
        <div class="communities-grid">
            @foreach (var cat in SortedCategories().Take(communityDisplayCount))
            {
                var subCount = subscriberCounts.GetValueOrDefault(cat.Value, 0);
                var postCount = postCounts.GetValueOrDefault(cat.Value, 0);
                var subscribed = subscribedCategories.Contains(cat.Value);
                <div class="community-card" @onclick='() => Nav.NavigateTo($"/group/{cat.Value}")'>
                    <span class="community-icon">@cat.Icon</span>
                    <span class="community-name">@cat.Label</span>
                    <span class="community-stats">@subCount subscribers · @postCount posts</span>
                    @if (subscribed)
                    {
                        <span class="subscribed-badge">✓</span>
                    }
                </div>
            }
        </div>
        <div class="see-more-row">
            @if (communityDisplayCount < categories.Count)
            {
                <button class="see-more-btn" @onclick="ShowMoreCommunities">See more</button>
            }
            @if (communityDisplayCount > 4)
            {
                <button class="see-more-btn" @onclick="() => communityDisplayCount = 4">See less</button>
            }
        </div>
    </div>

    @if (dilemmas == null)
    {
        <p class="loading">Loading dilemmas...</p>
    }
    else if (!dilemmas.Any())
    {
        <p class="empty-state">No dilemmas yet. <a href="/post">Be the first to post one!</a></p>
    }
    else
    {
        @foreach (var dilemma in dilemmas)
        {
            var totalVotesOnCard = dilemma.Options.Sum(o => o.Votes.Count);
            var isOwner = dilemma.UserId == currentUserId;
            var expired = IsExpired(dilemma);
            var votedOnThis = HasVotedOnDilemma(dilemma);

            <div class="dilemma-card @(isOwner ? "own-post" : "")">

                <div class="dilemma-meta">
                    @if (isOwner)
                    {
                        <span class="your-post-badge">Your post</span>
                    }
                    @if (!string.IsNullOrEmpty(dilemma.Category))
                    {
                        <span class="category-tag">@GetCategoryIcon(dilemma.Category) @dilemma.Category</span>
                    }
                    <span class="time-left">⏱ @GetTimeLeft(dilemma.ExpiresAt)</span>
                </div>

                <h2 class="dilemma-title" style="cursor:pointer"
                    @onclick='() => Nav.NavigateTo($"/dilemma/{dilemma.Id}")'>
                    @dilemma.Title
                </h2>
                @* <span class="post-author">@(dilemma.User?.DisplayName ?? dilemma.User?.UserName ?? "Unknown")</span> *@

                @if (!string.IsNullOrWhiteSpace(dilemma.Description))
                {
                    <p class="dilemma-desc">@dilemma.Description</p>
                }
                @if (!string.IsNullOrEmpty(dilemma.ImagePath))
                {
                    <img src="@dilemma.ImagePath" alt="Post image" class="card-image" />
                }

                <div class="options-list">
                    @foreach (var option in dilemma.Options)
                    {
                        var optionVotes = option.Votes.Count;
                        var percent = totalVotesOnCard > 0
                            ? (int)Math.Round((double)optionVotes / totalVotesOnCard * 100)
                            : 0;
                        var userVotedThis = userVotedOptionIds.Contains(option.Id);

                        <button class="option-btn @(userVotedThis ? "voted" : "") @(votedOnThis && !userVotedThis ? "dimmed" : "")"
                                @onclick="() => CastVote(dilemma, option)"
                                disabled="@(votedOnThis || isOwner || expired)">
                            <div class="option-content">
                                <span class="option-text">@option.OptionText</span>
                                @if (votedOnThis || isOwner || expired)
                                {
                                    <span class="option-percent">@percent%</span>
                                }
                            </div>
                            @if (votedOnThis || isOwner)
                            {
                                <div class="progress-bar">
                                    <div class="progress-fill @(userVotedThis || isOwner ? "fill-voted" : "")" style="width: @(percent)%"></div>
                                </div>
                            }
                        </button>
                    }
                </div>

                <div class="dilemma-footer">
                    <span>@totalVotesOnCard votes</span>
                    <span>@dilemma.Comments.Count comments</span>
                    @if (expired)
                    {
                        <span class="expired-tag">Expired</span>
                    }
                </div>

            </div>
        }
    }

</div>

@code {
    private List<Dilemma>? dilemmas;
    private string? currentUserId;
    private HashSet<Guid> userVotedOptionIds = new();
    private Dictionary<string, int> subscriberCounts = new();
    private Dictionary<string, int> postCounts = new();
    private HashSet<string> subscribedCategories = new();
    private int communityDisplayCount = 4;

    private record CategoryOption(string Value, string Label, string Icon, bool IsCustom = false);

    private List<CategoryOption> categories = new()
    {
        new("life",          "Life",          "🌱"),
        new("career",        "Career",        "💼"),
        new("finance",       "Finance",       "💰"),
        new("relationships", "Relationships", "❤️"),
        new("travel",        "Travel",        "✈️"),
        new("health",        "Health",        "🏃"),
        new("tech",          "Tech",          "💻"),
        new("other",         "Other",         "🤔"),
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        currentUserId = user?.Id;

        if (currentUserId != null)
        {
            var myVotes = await Db.Votes
                .Where(v => v.UserId == currentUserId)
                .Select(v => v.DilemmaOptionId)
                .ToListAsync();
            userVotedOptionIds = myVotes.ToHashSet();

            subscribedCategories = (await Db.CategorySubscriptions
                .Where(s => s.UserId == currentUserId)
                .Select(s => s.Category)
                .ToListAsync()).ToHashSet();
        }

        subscriberCounts = await Db.CategorySubscriptions
            .GroupBy(s => s.Category)
            .Select(g => new { Cat = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Cat, x => x.Count);

        postCounts = await Db.Dilemmas
            .GroupBy(d => d.Category)
            .Select(g => new { Cat = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.Cat, x => x.Count);

        var customCommunities = await Db.Communities.OrderBy(c => c.Name).ToListAsync();
        foreach (var c in customCommunities)
            categories.Add(new(c.Slug, c.Name, c.Icon, true));

        await LoadDilemmas();
    }

    private async Task LoadDilemmas()
    {
        dilemmas = await Db.Dilemmas
            .Include(d => d.User)
            .Include(d => d.Options).ThenInclude(o => o.Votes)
            .Include(d => d.Comments)
            .OrderByDescending(d => d.CreatedAt)
            .ToListAsync();
    }

    private async Task CastVote(Dilemma dilemma, DilemmaOption option)
    {
        if (currentUserId == null) { Nav.NavigateTo("/login"); return; }
        if (HasVotedOnDilemma(dilemma)) return;
        if (IsExpired(dilemma)) return;

        var vote = new Vote
        {
            Id = Guid.NewGuid(),
            UserId = currentUserId,
            DilemmaOptionId = option.Id,
            CreatedAt = DateTime.UtcNow
        };

        Db.Votes.Add(vote);
        await Db.SaveChangesAsync();

        @* userVotedOptionIds.Add(option.Id);
        option.Votes.Add(vote); *@
        userVotedOptionIds.Add(option.Id);
        await LoadDilemmas();

        StateHasChanged();
    }

    private List<CategoryOption> SortedCategories() =>
        categories
            .OrderByDescending(c => subscriberCounts.GetValueOrDefault(c.Value, 0))
            .ThenByDescending(c => postCounts.GetValueOrDefault(c.Value, 0))
            .ToList();

    private void ShowMoreCommunities() =>
        communityDisplayCount = Math.Min(communityDisplayCount + 4, categories.Count);

    private bool HasVotedOnDilemma(Dilemma dilemma) =>
        dilemma.Options.Any(o => userVotedOptionIds.Contains(o.Id));

    private bool IsExpired(Dilemma dilemma) =>
        dilemma.ExpiresAt.HasValue && dilemma.ExpiresAt.Value < DateTime.UtcNow;

    private string GetTimeLeft(DateTime? expiresAt)
    {
        if (!expiresAt.HasValue) return "No limit";
        var diff = expiresAt.Value - DateTime.UtcNow;
        if (diff <= TimeSpan.Zero) return "Expired";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m left";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h left";
        return $"{(int)diff.TotalDays}d left";
    }

    private string GetCategoryIcon(string? category) =>
        categories.FirstOrDefault(c => c.Value == category)?.Icon ?? "🤔";
}

<style>
    .home-page {
        max-width: 680px;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: Georgia, serif;
    }

    .home-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .home-header h1 { font-size: 2rem; margin: 0; }
    .home-header p  { color: #888; margin: 0.25rem 0 0; }

    .communities-section { margin-bottom: 2rem; }

    .communities-title {
        font-size: 1rem;
        font-weight: 700;
        color: #555;
        margin: 0 0 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .communities-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.5rem;
    }

    .community-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.2rem;
        padding: 0.75rem 0.5rem;
        border: 1px solid #e8e8e8;
        border-radius: 10px;
        background: white;
        cursor: pointer;
        text-align: center;
        transition: all 0.15s;
        position: relative;
    }

    .community-card:hover { border-color: #052767; background: #f0f4ff; box-shadow: 0 2px 8px rgba(0,0,0,0.06); }

    .community-icon  { font-size: 1.6rem; line-height: 1; }
    .community-name  { font-size: 0.82rem; font-weight: 600; color: #222; }
    .community-stats { font-size: 0.7rem; color: #aaa; }

    .subscribed-badge {
        position: absolute;
        top: 6px;
        right: 8px;
        font-size: 0.7rem;
        color: #052767;
        font-weight: 700;
    }

    .see-more-btn {
        display: block;
        margin: 0.6rem auto 0;
        background: none;
        border: none;
        color: #052767;
        font-size: 0.82rem;
        cursor: pointer;
        padding: 0.25rem 0.5rem;
        font-family: Georgia, serif;
    }

    .see-more-btn:hover { text-decoration: underline; }

    @@media (max-width: 480px) {
        .communities-grid { grid-template-columns: repeat(2, 1fr); }
    }

    .dilemma-card {
        border: 1px solid #e8e8e8;
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        transition: box-shadow 0.2s;
    }

    .dilemma-card:hover   { box-shadow: 0 2px 16px rgba(0,0,0,0.08); }
    .dilemma-card.own-post { border-color: #052767; border-width: 2px; }

    .dilemma-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
    }

    .your-post-badge {
        background: #052767;
        color: white;
        font-size: 0.72rem;
        padding: 2px 8px;
        border-radius: 20px;
        font-weight: 600;
    }

    .category-tag {
        background: #f0f4ff;
        color: #052767;
        font-size: 0.78rem;
        padding: 2px 8px;
        border-radius: 20px;
        text-transform: capitalize;
    }

    .time-left {
        font-size: 0.78rem;
        color: #888;
        margin-left: auto;
    }

    .dilemma-title {
        font-size: 1.15rem;
        margin: 0 0 0.15rem;
        font-weight: 700;
    }

    .post-author {
        font-size: 0.78rem;
        color: #aaa;
        display: block;
        margin: -0.25rem 0 0.5rem;
    }

    .dilemma-desc {
        font-size: 0.9rem;
        color: #555;
        margin: 0 0 0.75rem;
    }

    .card-image {
        width: 100%;
        max-height: 220px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 0.75rem;
    }

    .options-list {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .option-btn {
        width: 100%;
        text-align: left;
        background: #f9f9f9;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 0.6rem 0.85rem;
        cursor: pointer;
        transition: all 0.15s;
    }

    .option-btn:hover:not(:disabled) { border-color: #052767; background: #f0f4ff; }
    .option-btn.voted   { border-color: #052767; background: #f0f4ff; }
    .option-btn.dimmed  { opacity: 0.6; }
    .option-btn:disabled { cursor: default; }

    .option-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .option-text    { font-size: 0.92rem; }
    .option-percent { font-size: 0.82rem; font-weight: 600; color: #052767; }

    .progress-bar {
        height: 3px;
        background: #e0e0e0;
        border-radius: 2px;
        margin-top: 0.4rem;
    }

    .progress-fill {
        height: 100%;
        background: #ccc;
        border-radius: 2px;
        transition: width 0.4s ease;
    }

    .fill-voted { background: #052767; }

    .dilemma-footer {
        display: flex;
        gap: 1rem;
        font-size: 0.8rem;
        color: #aaa;
        margin-top: 0.5rem;
    }

    .expired-tag {
        margin-left: auto;
        color: #e06c75;
        font-weight: 600;
    }

    .loading, .empty-state {
        text-align: center;
        color: #aaa;
        padding: 3rem 0;
        font-style: italic;
    }

    .empty-state a { color: #052767; }

    @@media (max-width: 480px) {
        .filter-bar { gap: 0.3rem; }
        .filter-btn { font-size: 0.75rem; padding: 0.35rem 0.65rem; }
    }
</style>