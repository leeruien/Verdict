@page "/auth/reset-password"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using VerdictApp.Data
@inject VerdictApp.Services.SupabaseAuthService SupabaseAuth
@inject VerdictApp.Services.ResetSignInCache ResetSignInCache
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Reset Password — Verdict</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-logo">⚖</div>

        @if (isError)
        {
            <h1 class="auth-title">Link expired</h1>
            <p class="auth-sub">This reset link is invalid or has expired.</p>
            <a class="auth-btn" style="display:block;text-align:center;text-decoration:none;" href="/forgot-password">
                Request a new link
            </a>
        }
        else if (done)
        {
            <h1 class="auth-title">Password updated!</h1>
            <p class="auth-sub">Your password has been changed. You're now logged in.</p>
            <a class="auth-btn" style="display:block;text-align:center;text-decoration:none;" href="/">
                Go home ⚖
            </a>
        }
        else if (hasToken)
        {
            <h1 class="auth-title">Set new password</h1>

            <div class="form-field">
                <label>New password</label>
                <div class="password-wrap">
                    <input type="@(showPw ? "text" : "password")" class="form-input"
                           @bind="newPassword" placeholder="Min 8 characters" />
                    <button type="button" class="eye-btn" @onclick="() => showPw = !showPw">
                        <img src="@(showPw ? "icons/hide.png" : "icons/view.png")" width="20" />
                    </button>
                </div>
            </div>

            <div class="form-field">
                <label>Confirm new password</label>
                <input type="password" class="form-input"
                       @bind="confirmPassword" placeholder="Repeat password" />
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="auth-error">@error</p>
            }

            <button class="auth-btn" @onclick="Submit" disabled="@isBusy">
                @(isBusy ? "Updating…" : "Update password")
            </button>
        }
        else
        {
            <p class="auth-sub" style="text-align:center;">Checking your link…</p>
        }
    </div>
</div>

@code {
    // token_hash = new Supabase format (query string)
    // accessToken = old Supabase format (hash fragment, already a session token)
    private string? tokenHash;
    private string? accessToken;
    private bool hasToken => tokenHash != null || accessToken != null;

    private string newPassword = "";
    private string confirmPassword = "";
    private bool showPw;
    private bool isBusy;
    private bool isError;
    private bool done;
    private string? error;

    protected override void OnInitialized()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        tokenHash = query["token_hash"];
        if (!string.IsNullOrEmpty(query["error"])) isError = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hasToken || isError) return;

        // Old Supabase format — tokens arrive in the URL hash fragment
        var hash = await JS.InvokeAsync<string>("eval", "window.location.hash.substring(1)");
        if (!string.IsNullOrEmpty(hash))
        {
            var p = System.Web.HttpUtility.ParseQueryString(hash);
            var hashError = p["error"];
            if (!string.IsNullOrEmpty(hashError))
            {
                isError = true;
            }
            else
            {
                // Recovery tokens in the hash come as access_token (already issued by Supabase)
                accessToken = p["access_token"];
                if (string.IsNullOrEmpty(accessToken)) isError = true;
            }
        }
        else
        {
            isError = true;
        }

        StateHasChanged();
    }

    private async Task Submit()
    {
        error = null;

        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 8)
        {
            error = "Password must be at least 8 characters.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            error = "Passwords do not match.";
            return;
        }

        isBusy = true;

        string? email;

        try
        {
            email = tokenHash != null
                ? await SupabaseAuth.VerifyRecoveryAndUpdatePasswordAsync(tokenHash, newPassword)
                : await SupabaseAuth.UpdatePasswordWithAccessTokenAsync(accessToken!, newPassword);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            isBusy = false;
            return;
        }

        if (email == null)
        {
            isError = true;
            isBusy = false;
            return;
        }

        // Sync the new password into ASP.NET Core Identity
        var user = await UserManager.FindByEmailAsync(email);
        if (user != null)
        {
            await UserManager.RemovePasswordAsync(user);
            await UserManager.AddPasswordAsync(user, newPassword);
        }

        // Sign-in must happen in a minimal API endpoint (can't write cookies from Blazor).
        // Issue a one-time 60-second token and hand off via forceLoad navigation.
        var signInToken = ResetSignInCache.Issue(email);
        Nav.NavigateTo($"/auth/post-reset-signin?token={signInToken}", forceLoad: true);
    }
}

<style>
    .auth-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        font-family: Georgia, serif;
    }

    .auth-card {
        width: 100%;
        max-width: 400px;
        background: white;
        border: 1px solid #e8e8e8;
        border-radius: 16px;
        padding: 2.5rem 2rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    }

    .auth-logo { font-size: 2rem; text-align: center; margin-bottom: 0.5rem; }

    .auth-title { text-align: center; font-size: 1.5rem; margin: 0 0 0.5rem; color: #052767; }
    .auth-sub   { text-align: center; color: #888; font-size: 0.9rem; margin: 0 0 1.5rem; }

    .form-field { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 1rem; }
    .form-field label { font-size: 0.88rem; font-weight: 600; color: #333; }

    .form-input {
        padding: 0.6rem 0.85rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 0.95rem;
        font-family: Georgia, serif;
        width: 100%;
        box-sizing: border-box;
        transition: border-color 0.15s;
    }

    .form-input:focus { outline: none; border-color: #052767; }

    .password-wrap { position: relative; }
    .password-wrap .form-input { padding-right: 2.5rem; }

    .eye-btn {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
    }

    .auth-btn {
        width: 100%;
        padding: 0.75rem;
        background: #052767;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 1rem;
        font-family: Georgia, serif;
        cursor: pointer;
        transition: background 0.15s;
        margin-top: 0.25rem;
    }

    .auth-btn:hover:not(:disabled) { background: #3a0647; }
    .auth-btn:disabled { background: #aaa; cursor: not-allowed; }

    .auth-error {
        color: #c0392b;
        font-size: 0.85rem;
        margin: 0 0 0.5rem;
        padding: 0.5rem 0.75rem;
        background: #fdf2f2;
        border-radius: 6px;
        border-left: 3px solid #c0392b;
    }
</style>
