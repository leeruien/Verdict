@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using VerdictApp.Data
@using VerdictApp.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject IServiceScopeFactory ScopeFactory

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Verdict</a>
        <button class="sidebar-toggle" onclick="toggleSidebar()" aria-label="Collapse sidebar">‹</button>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon">🏠</span>
                <span class="nav-label">Home</span>
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="post">
                        <span class="nav-icon">➕</span>
                        <span class="nav-label">Post</span>
                    </NavLink>
                    <NavLink class="nav-link" href="inbox">
                        <span class="nav-icon">📨</span>
                        <span class="nav-label">Inbox</span>
                        @if (inboxCount > 0)
                        {
                            <span class="nav-count">@inboxCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="notification">
                        <span class="nav-icon">🔔</span>
                        <span class="nav-label">Notifications</span>
                        @if (notifCount > 0)
                        {
                            <span class="nav-count">@notifCount</span>
                        }
                    </NavLink>
                    <NavLink class="nav-link" href="profile">
                        <span class="nav-icon">👤</span>
                        <span class="nav-label">Profile</span>
                    </NavLink>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="nav-icon">🔑</span>
                        <span class="nav-label">Login</span>
                    </NavLink>
                    <NavLink class="nav-link" href="register">
                        <span class="nav-icon">🖊️</span>
                        <span class="nav-label">Register</span>
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private int notifCount;
    private int inboxCount;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        // Read the user ID directly from claims — avoids touching the shared scoped DbContext
        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId == null) return;

        await using var scope = ScopeFactory.CreateAsyncScope();
        var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();

        notifCount = await db.Notifications
            .CountAsync(n => n.RecipientUserId == userId && !n.IsRead);

        inboxCount = await db.Conversations
            .CountAsync(c => c.RecipientId == userId && c.Status == ConversationStatus.Pending);
    }
}
